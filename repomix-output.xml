### 3. 그래프를 여러개 구현하기

```swift
struct TripsChart: View {
    var body: some View {
        Chart(SampleTripRating.ratings, id: \.trip) { rating in
            PointMark(x: .value("Year", rating.trip), y: .value("Rating", rating.rating))
            
