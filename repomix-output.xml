    font-family:'Fira Code',monospace; font-size:11px; color:var(--dim); }
  .anchor b { color:var(--ink); }

  .legend { display:flex; gap:13px; flex-wrap:wrap; margin-top:9px; font-size:10.5px; color:var(--dim); font-family:'Fira Code',monospace; }
  .legend i { display:inline-block; width:11px; height:11px; border-radius:3px; vertical-align:-1px; margin-right:5px; }

  .note { margin-top:12px; font-size:12.5px; line-height:1.65; color:var(--dim); border-left:2px solid var(--line); padding-left:12px; }
  .note b { color:var(--ink); font-weight:600; }
  .note.alarm { border-left-color:var(--bad); }
  .note.fine { border-left-color:var(--ok); }
</style>
</head>
<body>

<h1>같은 심박을 몇 번이나 다시 받아올 것인가</h1>
<p class="lead">건강 저장소에 심박 샘플이 계속 쌓인다. 앱은 주기적으로 "새로 들어온 거 줘"라고 물어보는데, <code>anchor</code>는 <b>어디까지 가져갔는지 적어둔 책갈피</b>다. 이걸 안 들고 가면 매번 처음부터 다 받아온다.</p>

<div class="bar">
  <span>책갈피</span>
  <div class="seg" id="seg">
    <button type="button" class="danger" data-a="0" aria-pressed="true">anchor: nil (안 들고 감)</button>
    <button type="button" data-a="1" aria-pressed="false">직전 anchor 들고 감</button>
  </div>
  <span class="sp"></span>
  <button type="button" class="btn" id="reset">처음으로</button>
  <button type="button" class="btn primary" id="ask">한 번 물어보기</button>
</div>

<div class="row">
  <div class="cell"><div class="k">물어본 횟수</div><div class="v" id="v-q">--</div></div>
  <div class="cell"><div class="k">저장소에 쌓인 샘플</div><div class="v" id="v-total">--</div></div>
  <div class="cell"><div class="k">이번에 받은 샘플</div><div class="v" id="v-got">--</div></div>
  <div class="cell"><div class="k">지금까지 받은 총량</div><div class="v" id="v-sum">--</div></div>
</div>

<div class="store">
  <h2>건강 저장소의 심박 샘플</h2>
  <div class="dots" id="dots"></div>
  <div class="anchor" id="anchor-line"></div>
  <div class="legend">
    <span><i style="background:var(--mark)"></i>이미 받아둔 것</span>
    <span><i style="background:var(--mark);outline:2px solid var(--ok);outline-offset:1px"></i>이번에 받은 것</span>
    <span><i style="background:var(--dup)"></i>이미 받았는데 또 받은 것</span>
  </div>
</div>
<div class="note" id="note">"한 번 물어보기"를 눌러보자. 누를 때마다 그 사이에 심박이 몇 개 더 쌓인다.</div>

<script>
(function () {
  "use strict";
  var GROWTH = [12, 5, 4, 6, 3, 5, 4];   // 물어보는 사이사이에 새로 쌓이는 샘플 수

  var useAnchor = false, q = 0;

  function state() {
    var total = 0, anchor = 0, sum = 0, lastGot = 0, lastDup = 0, lastPrev = 0;
    for (var k = 0; k < q; k++) {
      var before = total; lastPrev = before;
      total += GROWTH[Math.min(k, GROWTH.length - 1)];
      var from = useAnchor ? anchor : 0;   // 책갈피가 없으면 늘 처음부터 다시 받는다
      lastGot = total - from;
      lastDup = useAnchor ? 0 : before;    // 이미 받았던 만큼이 그대로 중복이 된다
      sum += lastGot;
      anchor = total;
    }
    return { total: total, sum: sum, got: lastGot, dup: lastDup, anchor: anchor, prev: lastPrev };
  }

  function render() {
    var st = state();
    var set = function (id, v, cls) {
      var e = document.getElementById(id); e.textContent = v;
      e.parentElement.className = "cell" + (cls ? " " + cls : "");
    };
    set("v-q", q + "회");
    set("v-total", st.total + "개");
    set("v-got", q ? st.got + "개" + (st.dup ? " (중복 " + st.dup + ")" : "") : "--", st.dup ? "alarm" : (q ? "good" : ""));
    set("v-sum", q ? st.sum + "개" : "--", (q && !useAnchor && st.sum > st.total) ? "alarm" : "");

    var dots = "";
    for (var k = 0; k < st.total; k++) {
      var cls = "dot";
      if (q === 0) cls += "";
      else if (k < st.prev) cls += (useAnchor ? " got" : " dup");
      else cls += " got fresh";
      dots += '<div class="' + cls + '"></div>';
    }
    document.getElementById("dots").innerHTML = dots || '<span style="font-family:Fira Code,monospace;font-size:11px;color:var(--faint)">아직 없음</span>';

    document.getElementById("anchor-line").innerHTML = q === 0
      ? "책갈피: <b>없음</b>"
      : (useAnchor
          ? "다음에 들고 갈 책갈피: <b>" + st.anchor + "번째까지 받음</b>"
          : "책갈피를 안 들고 가니 다음에도 <b>1번째부터</b> 다시 받는다");

    var note = document.getElementById("note");
    if (q === 0) { note.className = "note"; note.textContent = '"한 번 물어보기"를 눌러보자. 누를 때마다 그 사이에 심박이 몇 개 더 쌓인다.'; return; }
    if (useAnchor) {
      note.className = "note fine";
      note.innerHTML = "책갈피 덕분에 <b>새로 쌓인 " + st.got + "개만</b> 받아왔다. " + q + "번 물어보는 동안 받은 총량이 " +
        st.sum + "개로, 저장소에 있는 " + st.total + "개와 정확히 같다. 한 샘플을 두 번 받는 일이 없다.";
    } else {
      note.className = "note alarm";
      note.innerHTML = "이번에 " + st.got + "개를 받았는데 그중 <b>" + st.dup + "개는 지난번에 이미 받았던 것</b>이다. " +
        q + "번 물어보는 동안 총 " + st.sum + "개를 받았고, 저장소에는 " + st.total + "개뿐이다. " +
        "<b>" + (st.sum - st.total) + "개는 헛수고</b>였던 셈이다. 7일치를 이렇게 계속 물어보면 이 낭비가 눈덩이처럼 커진다.";
    }
  }

  document.getElementById("ask").addEventListener("click", function () { if (q < 7) q++; render(); });
  document.getElementById("reset").addEventListener("click", function () { q = 0; render(); });
  document.querySelectorAll("#seg button").forEach(function (b) {
    b.addEventListener("click", function () {
      useAnchor = b.dataset.a === "1"; q = 0;
      document.querySelectorAll("#seg button").forEach(function (x) { x.setAttribute("aria-pressed", String(x === b)); });
      render();
    });
  });
  render();
})();
</script>
</body>
</html>
</file>

<file path="assets/demo/heartrate_gate_simulator.html">
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Heart Rate Gate Simulator</title>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['Fira Code', 'monospace'],
                    },
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #09090b;
            color: #f4f4f5;
            user-select: none;
            -webkit-user-select: none;
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #09090b; }
        ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 3px; }
        #marker {
            transition: left 1.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between p-4 md:p-8 overflow-x-hidden">

    <div class="max-w-4xl w-full mx-auto flex-1 flex flex-col justify-between gap-6">

        <header class="flex justify-between items-center border-b border-zinc-800/80 pb-4">
            <div>
                <h1 class="text-2xl md:text-3xl font-normal tracking-tight text-white">Heart Rate Gate</h1>
                <p class="text-xs text-zinc-500 mt-1">목표 심박 구간에 한 번 들어오기 전까지는 GPWS를 판정하지 않는 유예 구간</p>
            </div>
        </header>

        <main class="relative w-full flex-1 flex flex-col justify-center gap-8 my-2 rounded-xl bg-zinc-950/40 border border-zinc-900 p-6 pt-10 pb-10">

            <div class="relative w-full">
                <div class="relative w-full h-8 rounded-full bg-zinc-900 overflow-hidden border border-zinc-800">
                    <div class="absolute top-0 bottom-0 bg-emerald-500/20 border-l border-r border-emerald-500/40" style="left: 44.4%; width: 11.1%;"></div>
                </div>
                <div class="flex justify-between text-[9px] text-zinc-600 mt-1 font-mono">
                    <span>60</span><span>90</span><span>120</span>
                    <span class="text-emerald-500">140-160 목표</span>
                    <span>180 bpm</span>
                </div>
                <div id="marker" class="absolute -top-2 w-4 h-4 -ml-2 rounded-full bg-blue-400" style="left: 12.5%; box-shadow: 0 0 10px rgba(96,165,250,0.7);"></div>
            </div>

            <div class="grid grid-cols-2 gap-4 py-4 border-y border-zinc-900 max-w-2xl mx-auto w-full bg-zinc-950/20 rounded-lg px-6">
                <div class="text-center flex flex-col justify-center items-center py-2">
                    <span class="text-[10px] font-bold tracking-widest text-zinc-500 uppercase">현재 심박수</span>
                    <span id="hr-value" class="text-2xl font-bold mt-1 font-mono">75<span class="text-xs text-zinc-500 ml-1">bpm</span></span>
                </div>
                <div class="flex items-center justify-center relative py-2">
                    <div class="absolute left-0 h-10 w-[1px] bg-zinc-800/80"></div>
                    <div class="text-center flex flex-col justify-center items-center w-full">
                        <span class="text-[10px] font-bold tracking-widest text-zinc-500 uppercase">GPWS 상태</span>
                        <span id="gpws-text" class="text-xl font-bold mt-1 font-mono flex items-center gap-2">
                            <span id="gpws-dot" class="w-2.5 h-2.5 rounded-full bg-zinc-500 inline-block"></span>
                            NORMAL
                        </span>
                    </div>
                </div>
            </div>

            <div id="status-box" class="w-full max-w-2xl mx-auto text-center bg-zinc-900/20 p-4 rounded-lg border border-zinc-800/30">
                <span class="text-[10px] font-bold tracking-wider text-zinc-500 uppercase block mb-1">대기 중</span>
                <p id="status-desc" class="text-xs text-zinc-400 font-mono leading-relaxed">재생을 누르면 러닝이 시작되고 심박수가 서서히 오른다</p>
            </div>

        </main>

        <section class="space-y-4 p-5 bg-zinc-950/60 rounded-xl border border-zinc-900">

            <div class="flex items-center justify-between">
                <div class="flex flex-col">
                    <label class="text-sm font-medium text-zinc-300">isReachedHeartRate 유예 구간 (수정 후)</label>
                    <span id="toggleDesc" class="text-[11px] text-zinc-500">꺼보면 유예 구간 없이 시작하자마자 판정하던 수정 전 상태가 된다.</span>
                </div>
                <button id="toggleFix" class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none bg-emerald-500">
                    <span id="toggleKnob" class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-zinc-950 shadow ring-0 transition duration-200 ease-in-out translate-x-5"></span>
                </button>
            </div>

            <div class="h-[1px] bg-zinc-900"></div>

            <button id="playBtn" class="w-full px-3 py-2.5 rounded-lg border border-blue-400/40 bg-blue-400/10 text-blue-300 text-xs font-semibold transition-colors hover:bg-blue-400/20">
                재생: 심박 상승 시뮬레이션
            </button>

        </section>

    </div>

    <script>
        const state = { hasGate: true, playing: false };

        const toggleFix = document.getElementById('toggleFix');
        const toggleKnob = document.getElementById('toggleKnob');
        const toggleDesc = document.getElementById('toggleDesc');
        const playBtn = document.getElementById('playBtn');
        const marker = document.getElementById('marker');
        const hrValue = document.getElementById('hr-value');
        const gpwsText = document.getElementById('gpws-text');
        const gpwsDot = document.getElementById('gpws-dot');
        const statusDesc = document.getElementById('status-desc');
        const statusTitle = document.querySelector('#status-box span');
        const statusBox = document.getElementById('status-box');

        const TARGET = 150, DEVIATION = 10;
        // bpm 60~180 범위를 0~100%로 매핑
        const toPercent = bpm => ((bpm - 60) / (180 - 60)) * 100;

        const steps = [75, 95, 115, 135, 148, 152, 165];
        let reached = false;

        function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

        function gpwsFor(hr, gateOn) {
            const inZone = hr >= TARGET - DEVIATION && hr <= TARGET + DEVIATION;
            if (gateOn) {
                if (!reached && inZone) reached = true;
                if (!reached) return 'normal';
            }
            if (inZone) return 'normal';
            return hr < TARGET - DEVIATION ? 'sinkRate' : 'overspeed';
        }

        function renderGpws(status) {
            if (status === 'normal') {
                gpwsDot.className = "w-2.5 h-2.5 rounded-full bg-zinc-500 inline-block";
                gpwsText.innerHTML = '<span id="gpws-dot" class="w-2.5 h-2.5 rounded-full bg-zinc-500 inline-block"></span> NORMAL';
                gpwsText.className = "text-xl font-bold mt-1 font-mono flex items-center gap-2 text-zinc-300";
            } else if (status === 'sinkRate') {
                gpwsText.innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block animate-pulse"></span> SINK RATE';
                gpwsText.className = "text-xl font-bold mt-1 font-mono flex items-center gap-2 text-red-400";
            } else {
                gpwsText.innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block animate-pulse"></span> OVERSPEED';
                gpwsText.className = "text-xl font-bold mt-1 font-mono flex items-center gap-2 text-amber-400";
            }
        }

        function resetUI() {
            state.playing = false;
            reached = false;

            if (state.hasGate) {
                toggleFix.className = "relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none bg-emerald-500";
                toggleKnob.className = "pointer-events-none inline-block h-5 w-5 transform rounded-full bg-zinc-950 shadow ring-0 transition duration-200 ease-in-out translate-x-5";
                toggleDesc.innerText = "수정 후 상태. 목표 구간에 한 번 들어오기 전까진 NORMAL을 유지한다.";
            } else {
                toggleFix.className = "relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none bg-red-500";
                toggleKnob.className = "pointer-events-none inline-block h-5 w-5 transform rounded-full bg-zinc-950 shadow ring-0 transition duration-200 ease-in-out translate-x-0";
                toggleDesc.innerText = "이게 실제로 있던 문제다. 시작하자마자 바로 판정을 시작한다.";
            }

            marker.style.transition = "none";
            marker.style.left = toPercent(steps[0]) + "%";
            void marker.offsetWidth;
            marker.style.transition = "left 1.3s cubic-bezier(0.4, 0, 0.2, 1)";

            hrValue.innerHTML = steps[0] + '<span class="text-xs text-zinc-500 ml-1">bpm</span>';
            renderGpws('normal');
            statusBox.className = "w-full max-w-2xl mx-auto text-center bg-zinc-900/20 p-4 rounded-lg border border-zinc-800/30";
            statusTitle.innerText = "대기 중";
            statusDesc.innerText = "재생을 누르면 러닝이 시작되고 심박수가 서서히 오른다";

            playBtn.disabled = false;
            playBtn.className = "w-full px-3 py-2.5 rounded-lg border border-blue-400/40 bg-blue-400/10 text-blue-300 text-xs font-semibold transition-colors hover:bg-blue-400/20";
            playBtn.innerText = "재생: 심박 상승 시뮬레이션";
        }

        toggleFix.addEventListener('click', () => {
            state.hasGate = !state.hasGate;
            resetUI();
        });

        playBtn.addEventListener('click', () => {
            if (state.playing) return;
            playSequence();
        });

        async function playSequence() {
            state.playing = true;
            reached = false;
            playBtn.disabled = true;
            playBtn.className = "w-full px-3 py-2.5 rounded-lg border border-zinc-800 text-zinc-500 text-xs font-semibold cursor-default";
            playBtn.innerText = "재생 중...";

            for (const hr of steps) {
                marker.style.left = toPercent(hr) + "%";
                hrValue.innerHTML = hr + '<span class="text-xs text-zinc-500 ml-1">bpm</span>';
                const status = gpwsFor(hr, state.hasGate);
                renderGpws(status);

                if (status === 'normal') {
                    statusTitle.innerText = reached || (hr >= TARGET - DEVIATION && hr <= TARGET + DEVIATION) ? "목표 구간" : (state.hasGate ? "유예 구간 (판정 보류)" : "정상 범위");
                    statusDesc.innerText = state.hasGate && !reached
                        ? "아직 목표 구간에 한 번도 안 들어와서 판정을 보류한다"
                        : "목표 구간 안이라 경고 없음";
                    statusBox.className = "w-full max-w-2xl mx-auto text-center bg-zinc-900/20 p-4 rounded-lg border border-zinc-800/30";
                } else if (status === 'sinkRate') {
                    statusTitle.innerText = "SINK RATE 발생";
                    statusDesc.innerText = state.hasGate
                        ? "목표보다 낮지만 이미 한 번 도달한 뒤라 정상적으로 경고"
                        : "심박이 목표 구간 아래인데, 시작하자마자라 그냥 워밍업 중인 것뿐이다";
                    statusBox.className = "w-full max-w-2xl mx-auto text-center bg-red-950/20 p-4 rounded-lg border border-red-900/40";
                } else {
                    statusTitle.innerText = "OVERSPEED 발생";
                    statusDesc.innerText = "심박이 목표 구간을 넘어섰다";
                    statusBox.className = "w-full max-w-2xl mx-auto text-center bg-amber-950/20 p-4 rounded-lg border border-amber-900/40";
                }

                await sleep(1800);
            }

            playBtn.disabled = false;
            playBtn.className = "w-full px-3 py-2.5 rounded-lg border border-blue-400/40 bg-blue-400/10 text-blue-300 text-xs font-semibold transition-colors hover:bg-blue-400/20";
            playBtn.innerText = "다시 재생";
            state.playing = false;
        }

        resetUI();
    </script>
</body>
</html>
</file>

<file path="assets/demo/iir_beta_simulator.html">
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IIR Beta Simulator</title>
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#ffffff; --panel:#f7f8fa; --line:#e3e6ea; --ink:#16181d; --dim:#6b7280;
    --faint:#9aa1ab; --bad:#d0392b; --bad-bg:#fbeae8; --ok:#0d9276; --ok-bg:#e2f4ef;
    --raw:#9aa1ab; --f1:#b45309; --f2:#2563eb; --grid:#eceff2;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:#09090b; --panel:#141417; --line:#27272a; --ink:#f4f4f5; --dim:#a1a1aa;
      --faint:#71717a; --bad:#f87171; --bad-bg:#331416; --ok:#34d399; --ok-bg:#0d2b23;
      --raw:#52525b; --f1:#fbbf24; --f2:#60a5fa; --grid:#1c1c20;
    }
  }
  * { box-sizing:border-box; }
  body { margin:0; padding:16px; background:var(--bg); color:var(--ink);
    font-family:'Inter',-apple-system,'Apple SD Gothic Neo',sans-serif;
    user-select:none; -webkit-user-select:none; }
  h1 { font-size:15px; font-weight:700; margin:0 0 5px; }
  .lead { font-size:12.5px; line-height:1.6; color:var(--dim); margin:0 0 14px; max-width:66ch; }
  .lead code { font-family:'Fira Code',monospace; font-size:11.5px; background:var(--panel); padding:1px 5px; border-radius:4px; }

  .bar { display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-bottom:10px; }
  .bar > span { font-family:'Fira Code',monospace; font-size:10px; letter-spacing:.04em;
    color:var(--faint); text-transform:uppercase; }
  input[type=range]{ flex:1 1 200px; min-width:160px; accent-color:var(--ok); height:26px; }
  .seg { display:flex; border:1px solid var(--line); border-radius:7px; overflow:hidden; }
  .seg button { border:none; background:var(--bg); color:var(--dim); cursor:pointer;
    font-family:'Fira Code',monospace; font-size:11.5px; font-weight:500; padding:8px 12px;
    border-right:1px solid var(--line); transition:background .13s,color .13s; }
  .seg button:last-child { border-right:none; }
  .seg button[aria-pressed="true"] { background:var(--ok); color:var(--bg); font-weight:600; }
  .seg button.danger[aria-pressed="true"] { background:var(--bad); }
  .chips { display:flex; gap:6px; flex-wrap:wrap; }
  .chip { border:1px solid var(--line); background:var(--panel); color:var(--dim); cursor:pointer;
    font-family:'Fira Code',monospace; font-size:11px; padding:6px 10px; border-radius:6px; }
  .chip.on { background:var(--ok); border-color:var(--ok); color:var(--bg); font-weight:600; }

  .row { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; margin:12px 0; }
  .cell { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:9px 11px; min-width:0; }
  .cell .k { font-family:'Fira Code',monospace; font-size:8.5px; letter-spacing:.04em; text-transform:uppercase; color:var(--faint); }
  .cell .v { font-family:'Fira Code',monospace; font-size:16px; font-weight:600; margin-top:4px; font-variant-numeric:tabular-nums; }
  .cell.alarm { background:var(--bad-bg); border-color:var(--bad); }
  .cell.alarm .v { color:var(--bad); }
  .cell.good .v { color:var(--ok); }

  .track { border:1px solid var(--line); border-radius:9px; background:var(--panel); padding:10px 10px 4px; overflow-x:auto; }
  .track svg { display:block; width:100%; min-width:440px; height:auto; }
  .legend { display:flex; gap:14px; flex-wrap:wrap; margin-top:8px; font-size:11px; color:var(--dim); font-family:'Fira Code',monospace; }
  .legend i { display:inline-block; width:15px; height:2.5px; border-radius:2px; vertical-align:middle; margin-right:5px; }

  .note { margin-top:12px; font-size:12.5px; line-height:1.65; color:var(--dim); border-left:2px solid var(--line); padding-left:12px; }
  .note b { color:var(--ink); font-weight:600; }
  .note.alarm { border-left-color:var(--bad); }
  .note.fine { border-left-color:var(--ok); }
</style>
</head>
<body>

<h1>새로 들어온 값을 얼마나 믿을 것인가</h1>
<p class="lead">계수 β는 <b>방금 들어온 GPS 속도를 얼마나 반영할지</b>를 정한다. 크게 잡으면 빨리 따라가는 대신 GPS가 흔들리는 대로 같이 흔들리고, 작게 잡으면 잔잔한 대신 느리게 따라온다. 20초 지점에서 실제로 속도를 올린 상황이다.</p>

<div class="bar">
  <span>계수 β</span>
  <input type="range" id="b" min="3" max="60" value="15">
  <span id="b-label" style="font-size:12.5px;color:var(--ink);text-transform:none;letter-spacing:0;font-family:'Fira Code',monospace;font-weight:600">0.15</span>
  <div class="chips">
    <button type="button" class="chip" data-b="15">0.15</button>
    <button type="button" class="chip" data-b="18">0.18</button>
    <button type="button" class="chip" data-b="50">0.50</button>
  </div>
</div>
<div class="bar">
  <span>첫 샘플 보정</span>
  <div class="seg" id="seg">
    <button type="button" class="danger" data-s="0" aria-pressed="true">없음 (0에서 시작)</button>
    <button type="button" data-s="1" aria-pressed="false">첫 값으로 채우고 시작</button>
  </div>
</div>

<div class="row">
  <div class="cell"><div class="k">90%까지 따라잡는 시간</div><div class="v" id="v-settle">--</div></div>
  <div class="cell"><div class="k">흔들림 폭 (원본 대비)</div><div class="v" id="v-noise">--</div></div>
  <div class="cell"><div class="k">시작 1초 페이스</div><div class="v" id="v-first">--</div></div>
</div>

<div class="track">
  <div id="plot"></div>
  <div class="legend">
    <span><i style="background:var(--raw)"></i>GPS가 준 속도</span>
    <span><i style="background:var(--f1)"></i>1차 필터</span>
    <span><i style="background:var(--f2)"></i>2차 필터 (실제로 쓰는 값)</span>
  </div>
</div>
<div class="note" id="note"></div>

<script>
(function () {
  "use strict";
  var N = 140, STEP_AT = 20, V0 = 2.0, V1 = 2.9;

  var RAW = (function () {
    var out = [], seed = 20260611;
    for (var k = 0; k < N; k++) {
      seed = (seed * 1103515245 + 12345) % 2147483648;
      var noise = (seed / 2147483648 - 0.5) * 0.62;   // GPS 순간 속도의 흔들림
      out.push(Math.max(0.1, (k < STEP_AT ? V0 : V1) + noise));
    }
    return out;
  })();

  var beta = 0.15, seedInit = false;

  function run() {
    var f1 = 0, f2 = 0, init = false, s1 = [], s2 = [];
    for (var k = 0; k < N; k++) {
      var v = RAW[k];
      if (seedInit && !init) { f1 = v; f2 = v; init = true; }
      f1 = (1 - beta) * f1 + beta * v;
      f2 = (1 - beta) * f2 + beta * f1;
      s1.push(f1); s2.push(f2);
    }
    return { s1: s1, s2: s2 };
  }

  function fmtPace(v) {
    if (!(v > 0)) return "--:--";
    var p = 1000 / (v * 60), t = Math.round(p * 60);
    if (t > 3599) return "59'59\"+";
    return (t / 60 | 0) + "'" + String(t % 60).padStart(2, "0") + '"';
  }

  function render() {
    beta = +document.getElementById("b").value / 100;
    document.getElementById("b-label").textContent = beta.toFixed(2);
    document.querySelectorAll(".chip").forEach(function (c) {
      c.classList.toggle("on", Math.abs(+c.dataset.b / 100 - beta) < 1e-9);
    });

    var r = run();

    // 반응 속도는 노이즈 없는 계단 응답으로 잰다 (필터 자체의 성질)
    var settle = null, a = 0, b2 = 0;
    for (var k = 1; k <= 400; k++) {
      a = (1 - beta) * a + beta * 1;
      b2 = (1 - beta) * b2 + beta * a;
      if (b2 >= 0.9) { settle = k; break; }
    }

    // 흔들림 폭: 충분히 안정된 뒤 구간의 최고-최저
    function span(arr) {
      var t = arr.slice(N - 20);
      return Math.max.apply(null, t) - Math.min.apply(null, t);
    }
    var rawSpan = span(RAW), smSpan = span(r.s2);

    var set = function (id, v, cls) {
      var e = document.getElementById(id); e.textContent = v;
      e.parentElement.className = "cell" + (cls ? " " + cls : "");
    };
    set("v-settle", settle + "초", settle > 30 ? "alarm" : (settle <= 22 ? "good" : ""));
    set("v-noise", (smSpan / rawSpan * 100).toFixed(0) + "% 로 줄어듦", smSpan / rawSpan < 0.35 ? "good" : "alarm");
    set("v-first", fmtPace(r.s2[0]), seedInit ? "good" : "alarm");

    var W = 700, H = 200, PL = 38, PR = 10, PT = 12, PB = 24;
    var lo = 0, hi = 3.6;
    var X = function (k) { return PL + k / (N - 1) * (W - PL - PR); };
    var Y = function (v) { return PT + (hi - v) / (hi - lo) * (H - PT - PB); };
    var s = '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="필터 비교 그래프">';
    for (var g = 0; g <= 3; g++) {
      s += '<line x1="' + PL + '" y1="' + Y(g).toFixed(1) + '" x2="' + (W - PR) + '" y2="' + Y(g).toFixed(1) + '" stroke="var(--grid)" stroke-width="1"/>';
      s += '<text x="' + (PL - 6) + '" y="' + (Y(g) + 3.5).toFixed(1) + '" text-anchor="end" font-size="9" font-family="Fira Code,monospace" fill="var(--faint)">' + g + '</text>';
    }
    s += '<line x1="' + X(STEP_AT).toFixed(1) + '" y1="' + PT + '" x2="' + X(STEP_AT).toFixed(1) + '" y2="' + (H - PB) + '" stroke="var(--faint)" stroke-width="1" stroke-dasharray="3 3"/>';
    s += '<text x="' + (X(STEP_AT) + 5).toFixed(1) + '" y="' + (PT + 11) + '" font-size="9" font-family="Fira Code,monospace" fill="var(--faint)">여기서 속도를 올림</text>';
    if (settle !== null) {
      s += '<line x1="' + X(STEP_AT + settle).toFixed(1) + '" y1="' + PT + '" x2="' + X(STEP_AT + settle).toFixed(1) + '" y2="' + (H - PB) + '" stroke="var(--f2)" stroke-width="1" stroke-dasharray="2 3" opacity="0.7"/>';
    }
    function line(arr, color, w, dash) {
      return '<polyline points="' + arr.map(function (v, k) { return X(k).toFixed(1) + ',' + Y(Math.min(v, hi)).toFixed(1); }).join(' ') +
        '" fill="none" stroke="' + color + '" stroke-width="' + w + '"' + (dash ? ' stroke-dasharray="' + dash + '"' : '') + ' stroke-linejoin="round"/>';
    }
    s += line(RAW, "var(--raw)", 1.3, "3 2.5");
    s += line(r.s1, "var(--f1)", 1.6);
    s += line(r.s2, "var(--f2)", 2.4);
    s += '<text x="' + PL + '" y="' + (H - 7) + '" font-size="9" font-family="Fira Code,monospace" fill="var(--faint)">0초</text>';
    s += '<text x="' + (W - PR) + '" y="' + (H - 7) + '" text-anchor="end" font-size="9" font-family="Fira Code,monospace" fill="var(--faint)">' + (N - 1) + '초</text>';
    s += '</svg>';
    document.getElementById("plot").innerHTML = s;

    var note = document.getElementById("note");
    if (!seedInit) {
      note.className = "note alarm";
      note.innerHTML = "보정을 안 하면 필터가 <b>0에서 출발</b>한다. 이미 뛰고 있는데 계산된 속도는 0에 가깝고, 페이스는 그걸 뒤집은 값이라 " +
        "시작 1초에 <b>" + fmtPace(r.s2[0]) + "</b>가 찍힌다. 그래서 첫 샘플이 들어오는 순간 두 필터를 그 값으로 채우고 시작한다.";
    } else if (beta >= 0.4) {
      note.className = "note alarm";
      note.innerHTML = "β를 크게 잡으니 <b>" + settle + "초</b> 만에 따라잡는다. 대신 GPS의 흔들림이 거의 그대로 넘어와서 " +
        "화면의 페이스가 계속 출렁인다. 보정하기 전 상태가 이랬다.";
    } else if (beta <= 0.08) {
      note.className = "note alarm";
      note.innerHTML = "흔들림은 확실히 잡히는데 따라잡는 데 <b>" + settle + "초나 걸린다.</b> " +
        "실제로 속도를 올렸는데 화면은 한참 뒤에야 반응한다는 뜻이라, 경고가 늦게 풀린다.";
    } else {
      note.className = "note fine";
      note.innerHTML = "β = " + beta.toFixed(2) + "에서 흔들림은 원본의 <b>" + (smSpan / rawSpan * 100).toFixed(0) + "%</b>로 줄고, " +
        "속도를 올린 뒤 <b>" + settle + "초</b>면 따라잡는다. 사람이 뛰는 속도는 자동차처럼 급변하지 않으니 반응을 조금 양보하는 쪽이 맞다고 봤다.";
    }
  }

  document.getElementById("b").addEventListener("input", render);
  document.querySelectorAll(".chip").forEach(function (c) {
    c.addEventListener("click", function () { document.getElementById("b").value = c.dataset.b; render(); });
  });
  document.querySelectorAll("#seg button").forEach(function (b) {
    b.addEventListener("click", function () {
      seedInit = b.dataset.s === "1";
      document.querySelectorAll("#seg button").forEach(function (x) { x.setAttribute("aria-pressed", String(x === b)); });
      render();
    });
  });
  render();
})();
</script>
</body>
</html>
</file>

<file path="assets/demo/indexset-simulator.html">
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>Interactive IndexSet Simulator</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 20px;
    background: #0f172a;
    color: white;
    font-family: Arial, sans-serif;
}

.container {
    max-width: 980px;
    margin: 0 auto;
}

h1 {
    font-size: 24px;
    margin-bottom: 8px;
}

.desc {
    font-size: 13px;
    opacity: 0.75;
    line-height: 1.6;
    margin-bottom: 20px;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.panel {
    background: #111827;
    border-radius: 18px;
    padding: 16px;
}

.panel h2 {
    margin-top: 0;
    font-size: 17px;
}

.list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 14px;
}

.cell {
    height: 48px;
    background: #1e293b;
    border-radius: 12px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 2px solid transparent;
    transition: 0.25s;
}

.cell.selected {
    border-color: #facc15;
    background: #312e81;
    transform: scale(1.02);
}

.cell.removing {
    transform: translateX(-120%);
    opacity: 0;
}

.left {
    display: flex;
    align-items: center;
    gap: 10px;
}

.index {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: bold;
}

.name {
    font-size: 14px;
}

.action-row {
    display: flex;
    gap: 6px;
}

.btn {
    border: none;
    border-radius: 8px;
    font-size: 11px;
    padding: 5px 10px;
    cursor: pointer;
}

.select-btn {
    background: #facc15;
    color: black;
}

.delete-btn {
    background: #ef4444;
    color: white;
}

.green-btn {
    background: #22c55e;
    color: white;
}

.white-btn {
    background: white;
    color: black;
}

.btn-row {
    display: flex;
    gap: 8px;
    margin-top: 14px;
}

.section {
    margin-top: 18px;
}

.label {
    font-size: 12px;
    opacity: 0.7;
    margin-bottom: 8px;
}

.chips {
    min-height: 48px;
    background: black;
    border-radius: 12px;
    padding: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
}

.chip {
    background: #1d4ed8;
    color: white;
    padding: 7px 10px;
    border-radius: 999px;
    font-size: 12px;
    animation: pop 0.25s ease;
}

.chip.yellow {
    background: #ca8a04;
}

.chip.green {
    background: #15803d;
}

@keyframes pop {

    from {
        transform: scale(0.5);
        opacity: 0;
    }

    to {
        transform: scale(1);
        opacity: 1;
    }
}

.arrow {
    text-align: center;
    opacity: 0.5;
    margin: 10px 0;
    font-size: 13px;
}

.highlight {
    color: #facc15;
    font-weight: bold;
}


  @media (max-width: 560px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .panel { min-width: 0; }
  }
</style>
</head>

<body>

<div class="container">

    <h1>Index vs IndexSet</h1>

    <div class="grid">

        <!-- LEFT -->
        <div class="panel">

            <h2>Index</h2>

            <div class="list" id="intList"></div>

            <div class="section">

                <div class="label">
                    현재 전달되는 값
                </div>

                <div class="chips" id="singleValue">
                    <span style="opacity:0.4;font-size:12px;">
                        없음
                    </span>
                </div>

            </div>

            <div class="btn-row">

                <button class="btn white-btn"
                        onclick="resetInt()">
                    초기화
                </button>

            </div>

        </div>

        <!-- RIGHT -->
        <div class="panel">

            <h2>IndexSet</h2>

            <div class="list" id="setList"></div>

            <div class="section">

                <div class="label">
                    사용자 선택 순서
                </div>

                <div class="chips"
                     id="selectionOrder">
                </div>

                <div class="arrow">
                    ↓ SwiftUI가 IndexSet 생성
                </div>

                <div class="label">
                    실제 생성된 IndexSet
                </div>

                <div class="chips"
                     id="indexSetView">
                </div>

            </div>

            <div class="btn-row">

                <button class="btn green-btn"
                        onclick="deleteSelected()">
                    선택 삭제
                </button>

                <button class="btn white-btn"
                        onclick="resetSet()">
                    초기화
                </button>

            </div>

        </div>

    </div>

</div>

<script>

const original = [
    "Apple",
    "Banana",
    "Orange",
    "Mango"
];

let intItems = [...original];
let setItems = [...original];

let selectedIndexes = [];

const intList = document.getElementById("intList");
const setList = document.getElementById("setList");

function render() {

    renderInt();
    renderSet();
}

function renderInt() {

    intList.innerHTML = "";

    intItems.forEach((item, index) => {

        const cell = document.createElement("div");

        cell.className = "cell";

        cell.innerHTML = `
            <div class="left">

                <div class="index">
                    ${index}
                </div>

                <div class="name">
                    ${item}
                </div>

            </div>

            <button class="btn delete-btn">
                Delete
            </button>
        `;

        cell.querySelector(".delete-btn")
            .onclick = () => deleteInt(index, cell);

        intList.appendChild(cell);
    });
}

function renderSet() {

    setList.innerHTML = "";

    setItems.forEach((item, index) => {

        const selected =
            selectedIndexes.includes(index)
            ? "selected"
            : "";

        const cell = document.createElement("div");

        cell.className = `cell ${selected}`;

        cell.innerHTML = `
            <div class="left">

                <div class="index">
                    ${index}
                </div>

                <div class="name">
                    ${item}
                </div>

            </div>

            <div class="action-row">

                <button class="btn select-btn">
                    Select
                </button>

                <button class="btn delete-btn">
                    Delete
                </button>

            </div>
        `;

        cell.querySelector(".select-btn")
            .onclick = () => toggleIndex(index);

        cell.querySelector(".delete-btn")
            .onclick = () => deleteSingle(index, cell);

        setList.appendChild(cell);
    });
}

function toggleIndex(index) {

    if (selectedIndexes.includes(index)) {

        selectedIndexes =
            selectedIndexes.filter(i => i !== index);

    } else {

        selectedIndexes.push(index);
    }

    updateVisuals();

    renderSet();
}

function updateVisuals() {

    const selectionView =
        document.getElementById("selectionOrder");

    const indexSetView =
        document.getElementById("indexSetView");

    selectionView.innerHTML = "";
    indexSetView.innerHTML = "";

    if (selectedIndexes.length === 0) {

        selectionView.innerHTML =
            `<span style="opacity:0.4;font-size:12px;">
                없음
            </span>`;

        indexSetView.innerHTML =
            `<span style="opacity:0.4;font-size:12px;">
                없음
            </span>`;

        return;
    }

    // 선택 순서 표시
    selectedIndexes.forEach(index => {

        const chip =
            document.createElement("div");

        chip.className = "chip";

        chip.innerHTML = index;

        selectionView.appendChild(chip);
    });

    // 실제 IndexSet 정렬
    const sorted =
        [...selectedIndexes]
        .sort((a, b) => a - b);

    sorted.forEach(index => {

        const chip =
            document.createElement("div");

        chip.className = "chip yellow";

        chip.innerHTML = index;

        indexSetView.appendChild(chip);
    });

}

async function deleteInt(index, cell) {

    const singleValue =
        document.getElementById("singleValue");

    singleValue.innerHTML =
        `<div class="chip green">
            ${index}
        </div>`;

    await wait(350);

    cell.classList.add("removing");

    await wait(300);

    intItems.splice(index, 1);

    renderInt();
}

async function deleteSingle(index, cell) {

    selectedIndexes = [index];

    updateVisuals();

    await wait(350);

    cell.classList.add("removing");

    await wait(300);

    setItems.splice(index, 1);

    selectedIndexes = [];

    updateVisuals();

    renderSet();
}

async function deleteSelected() {

    if (selectedIndexes.length === 0) {
        return;
    }

    const sorted =
        [...selectedIndexes]
        .sort((a, b) => b - a);

    await wait(450);

    sorted.forEach(index => {
        setItems.splice(index, 1);
    });

    selectedIndexes = [];

    updateVisuals();

    renderSet();
}

function resetInt() {

    intItems = [...original];

    document.getElementById("singleValue")
        .innerHTML =
        `<span style="opacity:0.4;font-size:12px;">
            없음
        </span>`;

    renderInt();
}

function resetSet() {

    setItems = [...original];

    selectedIndexes = [];

    updateVisuals();

    renderSet();
}

function wait(ms) {

    return new Promise(resolve => {
        setTimeout(resolve, ms);
    });
}

render();

</script>

</body>
