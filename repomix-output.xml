            nodeUnused: "미참조된 객체",
            toggleDescInjection: "정상적인 단일 공유 참조 상태와 인스턴스 재생성으로 인한 오류를 토글합니다.",
            toggleDescSingleton: "싱글턴은 static let이라 인스턴스가 둘로 나뉠 수 없다. 이 토글은 주입 패턴에서만 의미가 있다."
        };

        // Setup Initial State
        const state = {
            pattern: 'injection',
            connected: true,
            heartRate: 145,
            particleOffset: 0
        };

        // DOM elements
        const patternSelect = document.getElementById('patternSelect');
        const toggleConnected = document.getElementById('toggleConnected');
        const toggleKnob = document.getElementById('toggleKnob');
        const toggleConnectedDesc = document.getElementById('toggleConnectedDesc');
        const hrSlider = document.getElementById('hrSlider');
        const hrValueText = document.getElementById('hrValueText');
        const dashboardHr = document.getElementById('dashboard-hr');
        const dashboardStatus = document.getElementById('dashboard-status');
        const statusTextVal = document.getElementById('status-text-val');
        const architectureDesc = document.getElementById('architecture-desc');

        // Dynamic Labels and Tags
        const nodeHealth = document.getElementById('node-health');
        const nodeRunning = document.getElementById('node-running');
        const nodeViewModel = document.getElementById('node-viewmodel');
        const nodeHealthTitle = document.getElementById('node-health-title');
        const nodeHealthSub = document.getElementById('node-health-sub');
        const nodeRunningSub = document.getElementById('node-running-sub');
        const nodeViewModelSub = document.getElementById('node-viewmodel-sub');
        const tooltipRunningText = document.getElementById('tooltip-running-text');
        const tooltipViewModelText = document.getElementById('tooltip-viewmodel-text');

        // Input Actions mapping
        patternSelect.addEventListener('change', (e) => {
            state.pattern = e.target.value;
            // 싱글턴은 static let이라 인스턴스가 나뉘는 시나리오 자체가 없다. 항상 connected로 고정한다.
            if (state.pattern === 'singleton') {
                state.connected = true;
            }
            updateUI();
        });

        toggleConnected.addEventListener('click', () => {
            if (state.pattern === 'singleton') return; // 싱글턴에서는 이 토글이 의미가 없다
            state.connected = !state.connected;
            updateUI();
        });

        hrSlider.addEventListener('input', (e) => {
            state.heartRate = parseInt(e.target.value);
            updateUI();
        });

        // Canvas Setup
        const canvas = document.getElementById('flowCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * window.devicePixelRatio;
            canvas.height = rect.height * window.devicePixelRatio;
            ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
        }

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function getRelativeCenter(elId) {
            const el = document.getElementById(elId);
            if (!el) return { x: 0, y: 0 };
            
            const canvasRect = canvas.getBoundingClientRect();
            const elRect = el.getBoundingClientRect();
            
            return {
                x: elRect.left - canvasRect.left + elRect.width / 2,
                y: elRect.top - canvasRect.top + elRect.height / 2
            };
        }

        // Draw animated connection helper
        function drawDashedLine(from, to, color, offset) {
            ctx.save();
            ctx.beginPath();
            ctx.moveTo(from.x, from.y);
            
            if (Math.abs(from.y - to.y) > 40 && Math.abs(from.x - to.x) > 100) {
                const midX = (from.x + to.x) / 2;
                ctx.bezierCurveTo(midX, from.y, midX, to.y, to.x, to.y);
            } else {
                ctx.lineTo(to.x, to.y);
            }
            
            ctx.strokeStyle = color;
            ctx.lineWidth = 2.5;
            ctx.setLineDash([8, 6]);
            ctx.lineDashOffset = -offset;
            
            ctx.shadowBlur = 10;
            ctx.shadowColor = color;
            ctx.stroke();

            // Flowing fluid particle indicator
            const distance = Math.hypot(to.x - from.x, to.y - from.y);
            const progress = (offset % distance) / distance;
            const px = from.x + (to.x - from.x) * progress;
            const py = from.y + (to.y - from.y) * progress;

            ctx.beginPath();
            ctx.arc(px, py, 5, 0, Math.PI * 2);
            ctx.fillStyle = color;
            ctx.shadowBlur = 15;
            ctx.shadowColor = '#ffffff';
            ctx.fill();
            
            ctx.restore();
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            state.particleOffset += 0.8;

            // Compute anchor endpoints
            const hRight = getRelativeCenter('anchor-health-right');
            const hBottom = getRelativeCenter('anchor-health-bottom');
            
            const rLeft = getRelativeCenter('anchor-running-left');
            const rBottom = getRelativeCenter('anchor-running-bottom');
            
            const vmTop = getRelativeCenter('anchor-viewmodel-top');
            const vmLeft = getRelativeCenter('anchor-viewmodel-left');

            const isMobile = window.innerWidth < 768;
            let primaryColor = state.connected ? '#3b82f6' : '#3f3f46';

            // Draw flow lines based on current states
            if (state.pattern === 'injection') {
                if (state.connected) {
                    if (!isMobile) {
                        drawDashedLine(hRight, rLeft, primaryColor, state.particleOffset);
                        drawDashedLine(rBottom, vmTop, primaryColor, state.particleOffset);
                    } else {
                        drawDashedLine(hBottom, rBottom, primaryColor, state.particleOffset);
                        drawDashedLine(rBottom, vmTop, primaryColor, state.particleOffset);
                    }
                } else {
                    const brokenInstanceRight = { x: hRight.x + 60, y: vmLeft.y };
                    if (!isMobile) {
                        drawDashedLine(brokenInstanceRight, vmLeft, '#ef4444', state.particleOffset);
                    } else {
                        drawDashedLine(hBottom, vmLeft, '#ef4444', state.particleOffset);
                    }
                }
            } else {
                // 싱글턴은 static let이라 항상 연결된 상태만 존재한다 (연결 끊김 케이스 없음)
                if (!isMobile) {
                    drawDashedLine(hRight, rLeft, '#10b981', state.particleOffset);
                    drawDashedLine(hRight, vmTop, '#10b981', state.particleOffset);
                } else {
                    drawDashedLine(hBottom, rBottom, '#10b981', state.particleOffset);
                    drawDashedLine(hBottom, vmTop, '#10b981', state.particleOffset);
                }
            }

            requestAnimationFrame(draw);
        }

        // Update UI Visual elements
        function updateUI() {
            hrValueText.innerText = state.heartRate;

            const isSingleton = state.pattern === 'singleton';

            // Toggle knob styling UI (싱글턴에서는 비활성화 표시)
            if (isSingleton) {
                toggleConnected.className = "relative inline-flex h-6 w-11 flex-shrink-0 cursor-not-allowed rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none bg-emerald-500/40";
                toggleKnob.className = "pointer-events-none inline-block h-5 w-5 transform rounded-full bg-zinc-950 shadow ring-0 transition duration-200 ease-in-out translate-x-5";
                toggleConnectedDesc.innerText = textConfig.toggleDescSingleton;
            } else if (state.connected) {
                toggleConnected.className = "relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none bg-emerald-500";
                toggleKnob.className = "pointer-events-none inline-block h-5 w-5 transform rounded-full bg-zinc-950 shadow ring-0 transition duration-200 ease-in-out translate-x-5";
                toggleConnectedDesc.innerText = textConfig.toggleDescInjection;
            } else {
                toggleConnected.className = "relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none bg-zinc-800";
                toggleKnob.className = "pointer-events-none inline-block h-5 w-5 transform rounded-full bg-zinc-400 shadow ring-0 transition duration-200 ease-in-out translate-x-0";
                toggleConnectedDesc.innerText = textConfig.toggleDescInjection;
            }

            const hNode = document.getElementById('node-health');
            const rNode = document.getElementById('node-running');
            const vmNode = document.getElementById('node-viewmodel');
            const anchorViewModelTop = document.getElementById('anchor-viewmodel-top');
            const anchorViewModelLeft = document.getElementById('anchor-viewmodel-left');

            if (state.pattern === 'injection') {
                if (state.connected) {
                    nodeHealthTitle.innerText = "HealthCenter";
                    nodeHealthSub.innerText = `[${textConfig.nodeInstance}]`;
                    nodeRunningSub.innerText = `[${textConfig.nodeInjected}]`;
                    nodeViewModelSub.innerText = `[${textConfig.nodeInjected}]`;
                    
                    anchorViewModelTop.classList.remove('hidden');
                    anchorViewModelLeft.classList.add('hidden');

                    architectureDesc.innerText = textConfig.patternInjectedDesc;
                    dashboardHr.innerText = state.heartRate;
                    statusTextVal.innerText = textConfig.statusSynced;
                    dashboardStatus.className = "text-xl font-bold text-emerald-400 mt-1 flex items-center gap-2";
                    dashboardStatus.innerHTML = `<span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block animate-ping"></span>${textConfig.statusSynced}`;

                    hNode.className = "relative bg-[#1c1c24] border border-blue-500/80 rounded-lg py-4 px-6 w-full max-w-[240px] shadow-2xl transition-all duration-300";
                    rNode.className = "relative bg-[#1c1c24] border border-zinc-700 rounded-lg py-4 px-6 w-full max-w-[240px] shadow-2xl transition-all duration-300";
                    vmNode.className = "relative bg-[#1c1c24] border border-zinc-700 rounded-lg py-4 px-6 w-full max-w-[240px] shadow-2xl transition-all duration-300";

                    tooltipRunningText.innerText = `HR: ${state.heartRate}`;
                    tooltipViewModelText.innerText = `HR: ${state.heartRate}`;
                } else {
                    nodeHealthTitle.innerText = "HealthCenter (Instance A)";
                    nodeHealthSub.innerText = `[${textConfig.nodeUnused}]`;
                    nodeRunningSub.innerText = "HealthCenter (Instance B)";
                    nodeViewModelSub.innerText = "HealthCenter (Instance A)";
                    
                    anchorViewModelTop.classList.add('hidden');
                    anchorViewModelLeft.classList.remove('hidden');

                    architectureDesc.innerText = textConfig.patternInjectedErrorDesc;
                    dashboardHr.innerText = "0";
                    statusTextVal.innerText = textConfig.statusMismatch;
                    dashboardStatus.className = "text-xl font-bold text-red-500 mt-1 flex items-center gap-2";
                    dashboardStatus.innerHTML = `<span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block animate-pulse"></span>${textConfig.statusMismatch}`;

                    hNode.className = "relative bg-[#1f1618] border border-red-900/80 rounded-lg py-4 px-6 w-full max-w-[240px] shadow-2xl transition-all duration-300";
                    rNode.className = "relative bg-[#1f1618] border border-red-900/80 rounded-lg py-4 px-6 w-full max-w-[240px] shadow-2xl transition-all duration-300 error-glow";
                    vmNode.className = "relative bg-[#1c1c24] border border-zinc-700 rounded-lg py-4 px-6 w-full max-w-[240px] shadow-2xl transition-all duration-300";

                    tooltipRunningText.innerText = `HR: --`;
                    tooltipViewModelText.innerText = `HR: ${state.heartRate}`;
                }
            } else {
                // static let shared는 프로세스가 살아있는 한 인스턴스가 하나뿐이라 연결이 끊기는 상태가 없다.
                nodeHealthTitle.innerText = "HealthCenter.shared";
                nodeHealthSub.innerText = `[${textConfig.nodeShared}]`;
                nodeRunningSub.innerText = `[${textConfig.nodeDirectRef}]`;
                nodeViewModelSub.innerText = `[${textConfig.nodeConsumer}]`;

                anchorViewModelTop.classList.remove('hidden');
                anchorViewModelLeft.classList.add('hidden');

                architectureDesc.innerText = `${textConfig.patternSingletonDesc}. ${textConfig.patternSingletonNote}`;
                dashboardHr.innerText = state.heartRate;
                statusTextVal.innerText = textConfig.statusSynced;
                dashboardStatus.className = "text-xl font-bold text-emerald-400 mt-1 flex items-center gap-2";
                dashboardStatus.innerHTML = `<span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block animate-ping"></span>${textConfig.statusSynced}`;

                hNode.className = "relative bg-[#151c19] border border-emerald-500/80 rounded-lg py-4 px-6 w-full max-w-[240px] shadow-2xl transition-all duration-300 success-glow";
                rNode.className = "relative bg-[#1c1c24] border border-zinc-700 rounded-lg py-4 px-6 w-full max-w-[240px] shadow-2xl transition-all duration-300";
                vmNode.className = "relative bg-[#1c1c24] border border-zinc-700 rounded-lg py-4 px-6 w-full max-w-[240px] shadow-2xl transition-all duration-300";

                tooltipRunningText.innerText = `HR: ${state.heartRate}`;
                tooltipViewModelText.innerText = `HR: ${state.heartRate}`;
            }
        }

        // Initialize App
        updateUI();
        draw();
    </script>
</body>
</html>
