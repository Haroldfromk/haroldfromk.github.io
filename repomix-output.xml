```swift
@State var isFromMain: Bool
@State var book: Document?
@State var markedBook: MarkedBookModel?

var title: String = ""
var authors: String = ""
var imageURL: String = ""
var price: Int = 0
var contents: String = ""

init(isFromMain: Bool, book: Document, markedBook: MarkedBookModel) {
    self.isFromMain = isFromMain
