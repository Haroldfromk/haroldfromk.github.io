        }
        .section-card.class-side { border-top: 6px solid #e03131; }
        .section-card.struct-side { border-top: 6px solid #1c7ed6; }

        .card-title { font-size: 18px; font-weight: bold; margin-top: 0; margin-bottom: 15px; display: flex; align-items: center; gap: 8px; }
        
        /* 캐릭터 및 데이터 월드 시각화 */
        .world {
