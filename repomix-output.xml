```swift
// MARK: - 계산기 본체
class Calculator {
    
    let add = AddOperation()
    let substract = SubstractOperation()
    let multiply = MutiplyOperation()
    let divide = DivideOperation()
    let mod = ModOperation()
}

// MARK: - 덧셈
class AddOperation  {
    func operation (first : Int, second : Int) {
        print(first + second)
    }
}

