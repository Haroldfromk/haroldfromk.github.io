        }
    }
    
    Button(today.didStudy ? "Studied" : "Study",
            systemImage: today.didStudy ? "checkmark.circle" : "book",
            intent: ToggleStudyIntent(date: today.date))
        .font(.caption)
        .tint(today.didStudy ? .mint : .orange)
        .controlSize(.small)
}
