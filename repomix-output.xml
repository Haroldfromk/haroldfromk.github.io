class DoublyLinkedList<T: Equatable> {
    // 생략
}

    func delete(value: T) {
        var current = head
        
        while let node = current {
            if node.value == value {
                let prevNode = node.prev
                let nextNode = node.next
                
                prevNode?.next = nextNode
                nextNode?.prev = prevNode
                
                if node === head {
                    head = nextNode
                }
                
                if node === tail {
                    tail = prevNode
                }
                
                return
            }
            
            // Move on to next node
            current = node.next
        }
    }
