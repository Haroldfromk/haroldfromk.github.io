<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>검색 파이프라인 시뮬레이터</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg: #0f0f1a; --surface: #1a1a2e; --surface2: #16213e;
  --border: rgba(255,255,255,0.08); --text: #e2e2f0; --dim: #7070a0;
  --accent: #a78bfa; --ok: #34d399; --warn: #fbbf24; --danger: #f87171;
  --mono: monospace;
}
body { background: var(--bg); color: var(--text); font-family: -apple-system, sans-serif; padding: 16px; }
h2 { font-size: 14px; color: var(--accent); margin-bottom: 6px; font-family: var(--mono); }
.desc { font-size: 11px; color: var(--dim); margin-bottom: 14px; line-height: 1.6; }

.input-row { display: flex; gap: 8px; margin-bottom: 6px; }
input[type=text] {
  flex: 1; background: var(--surface2); border: 1px solid var(--border);
  border-radius: 8px; padding: 8px 12px; color: var(--text); font-size: 13px; outline: none;
  font-family: var(--mono);
}
input[type=text]:focus { border-color: var(--accent); }
.resend-btn {
  background: var(--surface2); border: 1px solid var(--border); color: var(--dim);
  border-radius: 8px; padding: 8px 12px; font-size: 11px; font-family: var(--mono);
  cursor: pointer; white-space: nowrap; transition: all .2s;
}
.resend-btn:hover { border-color: var(--warn); color: var(--warn); }

.hint { font-size: 10px; color: var(--dim); margin-bottom: 14px; }
.hint span { color: var(--warn); }

.pipeline { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.stage {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 8px; padding: 10px 12px; display: flex; justify-content: space-between; align-items: center;
  transition: border-color .3s, background .3s;
}
.stage.pass { border-color: rgba(52,211,153,.4); background: rgba(52,211,153,.06); }
.stage.block { border-color: rgba(248,113,113,.4); background: rgba(248,113,113,.06); }
.stage.waiting { border-color: rgba(251,191,36,.4); background: rgba(251,191,36,.06); }
.stage-name { font-family: var(--mono); font-size: 11px; color: var(--accent); }
.stage-val { font-family: var(--mono); font-size: 11px; margin-top: 3px; }
.stage-status { font-size: 10px; font-family: var(--mono); }
.s-pass { color: var(--ok); }
.s-block { color: var(--danger); }
.s-wait { color: var(--warn); }

.result-lbl { font-size: 10px; color: var(--dim); margin-bottom: 4px; letter-spacing: .06em; text-transform: uppercase; }
.result { background: var(--surface2); border-radius: 8px; padding: 10px 12px; font-family: var(--mono); font-size: 11px; min-height: 36px; }
</style>
</head>
<body>
<h2>검색 파이프라인 시뮬레이터</h2>
<p class="desc">검색어를 입력하면 각 오퍼레이터를 단계별로 통과하는 과정을 확인할 수 있다.<br>
<span style="color:var(--warn)">같은 값 재전송</span> 버튼으로 removeDuplicates 동작을 확인해보자.</p>

<div class="input-row">
  <input type="text" id="searchInput" placeholder="검색어를 입력하세요..." oninput="onInput(this.value)">
  <button class="resend-btn" onclick="resend()">같은 값 재전송</button>
</div>
<div class="hint">💡 값 입력 후 <span>같은 값 재전송</span> 버튼을 눌러보세요 — removeDuplicates가 차단합니다</div>

<div class="pipeline">
  <div class="stage" id="s1">
    <div>
      <div class="stage-name">.removeDuplicates()</div>
      <div class="stage-val" id="v1" style="color:var(--dim)">-</div>
    </div>
    <div class="stage-status" id="st1">-</div>
  </div>
  <div class="stage" id="s2">
    <div>
      <div class="stage-name">.debounce(0.5s)</div>
      <div class="stage-val" id="v2" style="color:var(--dim)">대기 중...</div>
    </div>
    <div class="stage-status s-wait" id="st2">⏳</div>
  </div>
  <div class="stage" id="s3">
    <div>
      <div class="stage-name">.filter { count > 1 }</div>
      <div class="stage-val" id="v3" style="color:var(--dim)">-</div>
    </div>
    <div class="stage-status" id="st3">-</div>
  </div>
  <div class="stage" id="s4">
    <div>
      <div class="stage-name">.flatMap { API 호출 }</div>
      <div class="stage-val" id="v4" style="color:var(--dim)">-</div>
    </div>
    <div class="stage-status" id="st4">-</div>
  </div>
</div>

<div class="result-lbl">최종 결과</div>
<div class="result" id="result" style="color:var(--dim)">입력 대기 중...</div>

<script>
let debounceTimer = null;
let lastValue = null;

function onInput(val) {
  processValue(val, false);
}

function resend() {
  const val = document.getElementById('searchInput').value;
  if (!val) return;
  processValue(val, true);
}

function processValue(val, isResend) {
  const s1 = document.getElementById('s1');
  const v1 = document.getElementById('v1');
  const st1 = document.getElementById('st1');

  // removeDuplicates
  if (val === lastValue) {
    s1.className = 'stage block';
    v1.textContent = `"${val}" (이전과 동일)`;
    v1.style.color = 'var(--danger)';
    st1.textContent = '✗ 중복 차단';
    st1.className = 'stage-status s-block';
    resetBelow(2);
    document.getElementById('result').textContent = '중복 값 — removeDuplicates가 차단함';
    document.getElementById('result').style.color = 'var(--danger)';
    clearTimeout(debounceTimer);
    return;
  }

  lastValue = val;
  s1.className = 'stage pass';
  v1.textContent = `"${val}"`;
  v1.style.color = 'var(--ok)';
  st1.textContent = '✓ 통과';
  st1.className = 'stage-status s-pass';

  // debounce
  const s2 = document.getElementById('s2');
  const v2 = document.getElementById('v2');
  const st2 = document.getElementById('st2');
  s2.className = 'stage waiting';
  v2.textContent = '0.5초 대기 중...';
  v2.style.color = 'var(--warn)';
  st2.textContent = '⏳';
  st2.className = 'stage-status s-wait';
  resetBelow(3);
  document.getElementById('result').textContent = '0.5초 대기 중...';
  document.getElementById('result').style.color = 'var(--warn)';

  clearTimeout(debounceTimer);
  debounceTimer = setTimeout(() => {
    s2.className = 'stage pass';
    v2.textContent = `"${val}"`;
    v2.style.color = 'var(--ok)';
    st2.textContent = '✓ 통과';
    st2.className = 'stage-status s-pass';
    runFilter(val);
  }, 500);
}

function runFilter(val) {
  const s3 = document.getElementById('s3');
  const v3 = document.getElementById('v3');
  const st3 = document.getElementById('st3');
  if (val.length <= 1) {
    s3.className = 'stage block';
    v3.textContent = `"${val}" (${val.length}글자)`;
    v3.style.color = 'var(--danger)';
    st3.textContent = '✗ 2글자 미만 차단';
    st3.className = 'stage-status s-block';
    document.getElementById('s4').className = 'stage';
    document.getElementById('v4').textContent = '-';
    document.getElementById('v4').style.color = 'var(--dim)';
    document.getElementById('st4').textContent = '-';
    document.getElementById('result').textContent = '2글자 미만 — 차단됨';
    document.getElementById('result').style.color = 'var(--danger)';
  } else {
    s3.className = 'stage pass';
    v3.textContent = `"${val}" (${val.length}글자)`;
    v3.style.color = 'var(--ok)';
    st3.textContent = '✓ 통과';
    st3.className = 'stage-status s-pass';
    runAPI(val);
  }
}

function runAPI(val) {
  const s4 = document.getElementById('s4');
  const v4 = document.getElementById('v4');
  const st4 = document.getElementById('st4');
  s4.className = 'stage waiting';
  v4.textContent = `"${val}" 검색 중...`;
  v4.style.color = 'var(--warn)';
  st4.textContent = '⏳ API 호출';
  st4.className = 'stage-status s-wait';
  document.getElementById('result').textContent = 'API 호출 중...';
  document.getElementById('result').style.color = 'var(--warn)';

  setTimeout(() => {
    s4.className = 'stage pass';
    v4.textContent = `"${val}" → 결과 수신`;
    v4.style.color = 'var(--ok)';
    st4.textContent = '✓ 완료';
    st4.className = 'stage-status s-pass';
    document.getElementById('result').textContent = `"${val}" 검색 완료 — 결과 표시됨`;
    document.getElementById('result').style.color = 'var(--ok)';
  }, 400);
}

function resetBelow(from) {
  for (let i = from; i <= 4; i++) {
    document.getElementById('s'+i).className = 'stage';
    document.getElementById('v'+i).textContent = '-';
    document.getElementById('v'+i).style.color = 'var(--dim)';
    document.getElementById('st'+i).textContent = '-';
    document.getElementById('st'+i).className = 'stage-status';
  }
}
</script>
</body>
</html>
</file>

<file path="assets/demo/sim2_debounce_throttle.html">
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>debounce vs throttle</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg: #0f0f1a; --surface: #1a1a2e; --surface2: #16213e;
  --border: rgba(255,255,255,0.08); --text: #e2e2f0; --dim: #7070a0;
  --accent: #a78bfa; --ok: #34d399; --warn: #fbbf24; --danger: #f87171;
  --mono: monospace;
}
body { background: var(--bg); color: var(--text); font-family: -apple-system, sans-serif; padding: 16px; }
h2 { font-size: 14px; color: var(--accent); margin-bottom: 6px; font-family: var(--mono); }
.desc { font-size: 11px; color: var(--dim); margin-bottom: 14px; line-height: 1.6; }

.tabs { display: flex; gap: 6px; margin-bottom: 14px; }
.tab {
  flex: 1; padding: 8px; border-radius: 8px; border: 1px solid var(--border);
  background: var(--surface2); color: var(--dim); font-size: 12px; font-family: var(--mono);
  cursor: pointer; text-align: center; transition: all .2s;
}
.tab.active { border-color: var(--accent); color: var(--accent); background: rgba(167,139,250,.1); }

.panel { display: none; }
.panel.active { display: block; }

.info-box { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; font-size: 11px; color: var(--dim); line-height: 1.7; }
.info-box strong { color: var(--text); }

.btn-area { margin-bottom: 12px; }
.tap-btn {
  background: var(--accent); color: #fff; border: none; border-radius: 8px;
  padding: 10px 24px; font-size: 13px; cursor: pointer; font-family: var(--mono);
  transition: opacity .15s;
}
.tap-btn:hover { opacity: .85; }
.tap-btn:active { opacity: .7; }

.log-wrap { background: var(--surface2); border-radius: 8px; padding: 10px 12px; min-height: 120px; }
.log-lbl { font-size: 10px; color: var(--dim); margin-bottom: 6px; letter-spacing: .06em; text-transform: uppercase; }
.log { font-family: var(--mono); font-size: 11px; }
.log-item { padding: 3px 0; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; }
.log-item:last-child { border-bottom: none; }
.log-in { color: var(--dim); }
.log-out { color: var(--ok); font-weight: bold; }
.log-block { color: var(--danger); }
</style>
</head>
<body>
<h2>debounce vs throttle</h2>
<p class="desc">버튼을 연타해서 두 오퍼레이터가 어떻게 다르게 동작하는지 확인해보자.</p>

<div class="tabs">
  <div class="tab active" onclick="switchTab('debounce')">debounce</div>
  <div class="tab" onclick="switchTab('throttle')">throttle</div>
</div>

<!-- debounce panel -->
<div class="panel active" id="panel-debounce">
  <div class="info-box">
    <strong>debounce(0.5s)</strong><br>
    버튼을 눌러도 0.5초 동안 추가 입력이 없을 때만 통과한다.<br>
    연타하면 계속 타이머가 리셋되어 마지막 입력만 통과한다.
  </div>
  <div class="btn-area">
    <button class="tap-btn" onclick="tapDebounce()">버튼 탭 (연타해보세요)</button>
  </div>
  <div class="log-wrap">
    <div class="log-lbl">이벤트 로그</div>
    <div class="log" id="log-debounce"><span style="color:var(--dim)">버튼을 눌러보세요...</span></div>
  </div>
</div>

<!-- throttle panel -->
<div class="panel" id="panel-throttle">
  <div class="info-box">
    <strong>throttle(2s)</strong><br>
    2초 안에 아무리 많이 눌러도 첫 번째 입력만 통과한다.<br>
    2초가 지나야 다음 입력이 통과된다.
  </div>
  <div class="btn-area">
    <button class="tap-btn" onclick="tapThrottle()">버튼 탭 (연타해보세요)</button>
  </div>
  <div class="log-wrap">
    <div class="log-lbl">이벤트 로그</div>
    <div class="log" id="log-throttle"><span style="color:var(--dim)">버튼을 눌러보세요...</span></div>
  </div>
</div>

<script>
let debounceTimer = null;
let debounceCount = 0;
let throttleLastTime = 0;
let throttleCount = 0;

function switchTab(name) {
  document.querySelectorAll('.tab').forEach((t, i) => {
    t.classList.toggle('active', (i === 0 && name === 'debounce') || (i === 1 && name === 'throttle'));
  });
  document.getElementById('panel-debounce').classList.toggle('active', name === 'debounce');
  document.getElementById('panel-throttle').classList.toggle('active', name === 'throttle');
}

function addLog(logId, text, type) {
  const log = document.getElementById(logId);
  if (log.querySelector('span')) log.innerHTML = '';
  const item = document.createElement('div');
  item.className = 'log-item';
  const time = new Date().toLocaleTimeString('ko-KR', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
  item.innerHTML = `<span class="log-${type}">${text}</span><span style="color:var(--dim);font-size:10px">${time}</span>`;
  log.insertBefore(item, log.firstChild);
  if (log.children.length > 8) log.removeChild(log.lastChild);
}

function tapDebounce() {
  debounceCount++;
  const n = debounceCount;
  addLog('log-debounce', `입력 #${n} — 타이머 리셋`, 'in');
  clearTimeout(debounceTimer);
  debounceTimer = setTimeout(() => {
    addLog('log-debounce', `✓ #${n} 통과 — 0.5초 경과`, 'out');
  }, 500);
}

function tapThrottle() {
  throttleCount++;
  const n = throttleCount;
  const now = Date.now();
  if (now - throttleLastTime >= 2000) {
    throttleLastTime = now;
    addLog('log-throttle', `✓ #${n} 통과`, 'out');
  } else {
    const remain = ((2000 - (now - throttleLastTime)) / 1000).toFixed(1);
    addLog('log-throttle', `✗ #${n} 차단 — ${remain}초 남음`, 'block');
  }
}
</script>
</body>
</html>
</file>

<file path="assets/demo/sim3_transform.html">
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>map / compactMap / flatMap</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg: #0f0f1a; --surface: #1a1a2e; --surface2: #16213e;
  --border: rgba(255,255,255,0.08); --text: #e2e2f0; --dim: #7070a0;
  --accent: #a78bfa; --ok: #34d399; --warn: #fbbf24; --danger: #f87171;
  --mono: monospace;
}
body { background: var(--bg); color: var(--text); font-family: -apple-system, sans-serif; padding: 16px; }
h2 { font-size: 14px; color: var(--accent); margin-bottom: 6px; font-family: var(--mono); }
.desc { font-size: 11px; color: var(--dim); margin-bottom: 14px; line-height: 1.6; }
.tabs { display: flex; gap: 6px; margin-bottom: 14px; }
.tab {
  flex: 1; padding: 8px; border-radius: 8px; border: 1px solid var(--border);
  background: var(--surface2); color: var(--dim); font-size: 12px; font-family: var(--mono);
  cursor: pointer; text-align: center; transition: all .2s;
}
.tab.active { border-color: var(--accent); color: var(--accent); background: rgba(167,139,250,.1); }
.panel { display: none; }
.panel.active { display: block; }
.info-box { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; font-size: 11px; color: var(--dim); line-height: 1.7; }
.info-box strong { color: var(--text); }
.input-row { display: flex; gap: 8px; margin-bottom: 10px; align-items: center; }
input[type=text] {
  flex: 1; background: var(--surface2); border: 1px solid var(--border);
  border-radius: 8px; padding: 8px 12px; color: var(--text); font-size: 13px; outline: none;
  font-family: var(--mono);
}
input:focus { border-color: var(--accent); }
.run-btn {
  background: var(--accent); color: #fff; border: none; border-radius: 8px;
  padding: 8px 16px; font-size: 12px; cursor: pointer; font-family: var(--mono);
  white-space: nowrap;
}
.run-btn:hover { opacity: .85; }
.result-box { background: var(--surface2); border-radius: 8px; padding: 10px 12px; font-family: var(--mono); font-size: 12px; min-height: 50px; }
.r-lbl { font-size: 10px; color: var(--dim); margin-bottom: 5px; text-transform: uppercase; letter-spacing: .06em; }
.r-ok { color: var(--ok); }
.r-nil { color: var(--danger); }
.r-warn { color: var(--warn); }

/* flatMap */
.fm-btns { display: flex; gap: 8px; margin-bottom: 10px; }
.fm-btn {
  flex: 1; padding: 9px; border-radius: 8px; border: none; font-size: 11px;
  font-family: var(--mono); cursor: pointer; transition: opacity .15s;
}
.fm-btn:hover { opacity: .85; }
.fm-btn-a { background: rgba(52,211,153,.2); color: var(--ok); border: 1px solid rgba(52,211,153,.3); }
.fm-btn-b { background: rgba(167,139,250,.2); color: var(--accent); border: 1px solid rgba(167,139,250,.3); }
.tl { display: flex; flex-direction: column; gap: 4px; }
.tl-item { padding: 5px 8px; border-radius: 6px; font-family: var(--mono); font-size: 11px; border: 1px solid var(--border); background: var(--surface2); animation: fadeIn .3s; }
.tl-ok { border-color: rgba(52,211,153,.3); color: var(--ok); }
.tl-info { color: var(--dim); }
.tl-warn { border-color: rgba(251,191,36,.3); color: var(--warn); }
@keyframes fadeIn { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: translateY(0); } }
</style>
</head>
<body>
<h2>map / compactMap / flatMap</h2>
<p class="desc">각 오퍼레이터에 값을 넣어서 어떻게 변환되는지 확인해보자.</p>

<div class="tabs">
  <div class="tab active" onclick="switchTab('map')">map</div>
  <div class="tab" onclick="switchTab('compactMap')">compactMap</div>
  <div class="tab" onclick="switchTab('flatMap')">flatMap</div>
</div>

<!-- map -->
<div class="panel active" id="panel-map">
  <div class="info-box">
    <strong>map { $0.uppercased() }</strong><br>
    모든 값을 변환한다. 값의 타입이나 형태를 바꿀 때 사용한다.
  </div>
  <div class="input-row">
    <input type="text" id="map-input" placeholder="텍스트를 입력하세요">
    <button class="run-btn" onclick="runMap()">실행</button>
  </div>
  <div class="r-lbl">결과</div>
  <div class="result-box" id="map-result" style="color:var(--dim)">입력 후 실행을 눌러보세요</div>
</div>

<!-- compactMap -->
<div class="panel" id="panel-compactMap">
  <div class="info-box">
    <strong>compactMap { Int($0) }</strong><br>
    변환 결과가 nil이면 자동으로 걸러낸다. 숫자로 변환할 수 없는 값은 제거된다.
  </div>
  <div class="input-row">
    <input type="text" id="cm-input" placeholder="쉼표로 구분: 1, 둘, 3, four, 5">
    <button class="run-btn" onclick="runCompactMap()">실행</button>
  </div>
  <div class="r-lbl">결과</div>
  <div class="result-box" id="cm-result" style="color:var(--dim)">입력 후 실행을 눌러보세요</div>
</div>

<!-- flatMap -->
<div class="panel" id="panel-flatMap">
  <div class="info-box">
    <strong>flatMap { API 호출 }</strong><br>
    단순 이벤트를 새로운 비동기 스트림으로 전환한다.<br>
    새 이벤트가 오면 이전 요청을 취소하고 새 요청으로 교체한다.
  </div>
  <div class="fm-btns">
    <button class="fm-btn fm-btn-a" onclick="fmSend('harold')">검색: "harold"</button>
    <button class="fm-btn fm-btn-b" onclick="fmSend('dongik')">검색: "dongik"</button>
  </div>
  <div class="r-lbl">스트림 로그</div>
  <div class="result-box">
    <div class="tl" id="fm-log"><span style="color:var(--dim)">버튼을 눌러보세요...</span></div>
  </div>
</div>

<script>
function switchTab(name) {
  ['map','compactMap','flatMap'].forEach((n, i) => {
    document.querySelectorAll('.tab')[i].classList.toggle('active', n === name);
    document.getElementById('panel-' + n).classList.toggle('active', n === name);
  });
}

function runMap() {
  const val = document.getElementById('map-input').value;
  const box = document.getElementById('map-result');
  if (!val) { box.textContent = '값을 입력하세요'; box.style.color = 'var(--dim)'; return; }
  box.innerHTML = `입력: <span style="color:var(--dim)">"${val}"</span><br>` +
    `map { $0.uppercased() }<br>` +
    `출력: <span class="r-ok">"${val.toUpperCase()}"</span>`;
}

function runCompactMap() {
  const val = document.getElementById('cm-input').value;
  const box = document.getElementById('cm-result');
  if (!val) { box.textContent = '값을 입력하세요'; box.style.color = 'var(--dim)'; return; }
  const items = val.split(',').map(s => s.trim());
  const results = items.map(s => ({ raw: s, result: isNaN(parseInt(s)) ? null : parseInt(s) }));
  const passed = results.filter(r => r.result !== null).map(r => r.result);
  let html = `입력: <span style="color:var(--dim)">[${items.map(i => '"'+i+'"').join(', ')}]</span><br><br>`;
  results.forEach(r => {
    if (r.result !== null) html += `<span class="r-ok">✓ "${r.raw}" → ${r.result}</span><br>`;
    else html += `<span class="r-nil">✗ "${r.raw}" → nil (제거)</span><br>`;
  });
  html += `<br>최종: <span class="r-ok">[${passed.join(', ')}]</span>`;
  box.innerHTML = html;
}

let fmTimer = null;
let fmCount = 0;

function fmSend(query) {
  fmCount++;
  const log = document.getElementById('fm-log');
  if (log.querySelector('span')) log.innerHTML = '';

  // 이전 요청 취소
  if (fmTimer) {
    clearTimeout(fmTimer);
    const cancel = document.createElement('div');
    cancel.className = 'tl-item tl-warn';
    cancel.textContent = '✗ 이전 요청 취소됨';
    log.insertBefore(cancel, log.firstChild);
  }

  const start = document.createElement('div');
  start.className = 'tl-item tl-info';
  start.textContent = `→ flatMap: "${query}" 검색 요청 시작`;
  log.insertBefore(start, log.firstChild);

  fmTimer = setTimeout(() => {
    fmTimer = null;
    const done = document.createElement('div');
    done.className = 'tl-item tl-ok';
    done.textContent = `✓ "${query}" 결과 수신 완료`;
    log.insertBefore(done, log.firstChild);
    if (log.children.length > 8) log.removeChild(log.lastChild);
  }, 800);

  if (log.children.length > 8) log.removeChild(log.lastChild);
}
</script>
</body>
</html>
</file>

