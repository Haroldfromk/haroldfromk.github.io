  .c-hold { border-color: var(--hold); color: var(--hold); background: var(--hold-soft); }
  .c-wait { border-color: var(--sub); color: var(--sub); background: transparent; border-style: dashed; }
  .c-done { border-color: var(--ok); color: var(--ok); background: var(--ok-soft); }

  .msg { margin-top: 12px; font-size: 13px; line-height: 1.5; height: 40px; overflow: hidden; }
