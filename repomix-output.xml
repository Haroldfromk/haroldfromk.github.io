                        <button class="btn-reset" onclick="resetStruct()">데이터 리셋</button>
                    </div>
                </div>
            </div>
            
            <div class="log-message" id="struct-log">
                우측 버튼을 눌러보세요. 기장님이 고도를 계속 높여도 고양이가 받은 택배 상자(스냅샷)는 전혀 영향을 받지 않습니다.
            </div>
        </div>
    </div>
</div>

<script>
    // Class State
    let classAlt = 1000;

    function classActorWork() {
        classAlt += 500;
        document.getElementById('c-alt-val').innerText = classAlt;
        triggerFlash('class-house', 'flash-red');
        document.getElementById('class-log').innerHTML = "👨‍✈️ 기장님이 비행 중 고도를 올렸습니다. 같은 집을 바라보므로 🐱 고양이 화면의 값도 같이 올라갑니다.";
        document.getElementById('class-log').style.color = "#c92a2a";
    }

    function classVMWork() {
        classAlt = 1500;
        document.getElementById('c-alt-val').innerText = classAlt;
        triggerFlash('class-house', 'flash-red');
        document.getElementById('class-log').innerHTML = "⚠️ <strong>데이터 레이스 위험!</strong> 고양이가 고도를 1500으로 페인팅하는 순간, 기장님의 실제 데이터 하우스도 오염됩니다. 만약 동시에 고치면 데이터가 깨집니다 (Shared Mutable State)!";
        document.getElementById('class-log').style.color = "#e03131";
    }

    function resetClass() {
        classAlt = 1000;
        document.getElementById('c-alt-val').innerText = classAlt;
        document.getElementById('class-log').innerText = "클래스 데이터가 리셋되었습니다.";
        document.getElementById('class-log').style.color = "#495057";
    }

    // Struct State
    let structActorAlt = 1500;
    let structCopyAlt = 1500;

    function structActorWork() {
        structActorAlt += 500;
        document.getElementById('s-actor-alt').innerText = structActorAlt;
        document.getElementById('struct-log').innerHTML = "👨‍✈️ 기장님(Actor)은 계속 비행하며 고도를 올리는 중! (현재: " + structActorAlt + "). 하지만 이미 보내준 택배 상자는 안전합니다.";
        document.getElementById('struct-log').style.color = "#1864ab";
    }

    function structVMWork() {
        document.getElementById('struct-log').innerHTML = "🐱 <strong>독립적인 상태 완료!</strong> 고양이는 예전에 전달받은 스냅샷(고도: " + structCopyAlt + ")만 조용히 바라봅니다. 기장님이 뭘 하든 데이터 레이스가 절대 일어나지 않습니다 (Sendable 충족)!";
        triggerFlash('struct-box', 'flash-blue');
        document.getElementById('struct-log').style.color = "#1c7ed6";
    }

    function resetStruct() {
        structActorAlt = 1500;
        structCopyAlt = 1500;
        document.getElementById('s-actor-alt').innerText = structActorAlt;
        document.getElementById('s-copy-alt').innerText = structCopyAlt;
        document.getElementById('s-vm-alt').innerText = structCopyAlt;
        document.getElementById('struct-log').innerText = "구조체 데이터가 리셋되었습니다.";
        document.getElementById('struct-log').style.color = "#495057";
    }

    function triggerFlash(elementId, className) {
        const el = document.getElementById(elementId);
        el.classList.remove(className);
        void el.offsetWidth; // trigger reflow
        el.classList.add(className);
    }
</script>

</body>
</html>
