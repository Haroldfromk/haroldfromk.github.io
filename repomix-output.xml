    <style>
        :root {
            --bg-color: #f5f7fa;
            --card-bg: #ffffff;
            --text-color: #2c3e50;
            --border-color: #e2e8f0;
            --primary-color: #007aff;
            --danger-color: #ff3b30;
            --success-color: #34c759;
