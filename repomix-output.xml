            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            min-height: 240px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            position: relative;
        }
        
        .actor-box, .viewmodel-box {
            background: white;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid #dee2e6;
            font-size: 13px;
        }
        
        .house-object {
            background: #fff9db;
            border: 2px solid #fab005;
            border-radius: 12px;
            padding: 12px;
            text-align: center;
            font-family: monospace;
            font-weight: bold;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
