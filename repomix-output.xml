    /* Ghost controls keep a 44px hit area while the visible pill stays compact;
       Export is the one primary action. */
    .toolbar button {
      position: relative;
      isolation: isolate;
      background: transparent;
      color: var(--text-muted);
      border: 0;
      padding: 0.5rem 0.75rem;
      border-radius: 0.5625rem;
      font-family: inherit;
      font-size: 0.8125rem;
      font-weight: 500;
      cursor: pointer;
