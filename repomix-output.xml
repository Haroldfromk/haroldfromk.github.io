<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root {
    --bg: #0b0f14;
    --panel: #141a22;
    --border: #2a3542;
    --muted: #8a95a3;
    --text: #c7d0da;
    --cyan: #3fe6c4;
    --red: #ff6b6b;
    --red-bg: #3a1414;
    --red-border: #7a2a2a;
    --green-bg: #12332c;
    --green-border: #1f6f5c;
    --green: #7ff0d4;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    padding: 20px;
  }
  .wrap { max-width: 760px; margin: 0 auto; }
  h1 {
    font-size: 15px;
    color: var(--cyan);
    letter-spacing: 0.5px;
    margin: 0 0 14px;
    font-weight: 700;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .controls label { font-size: 12px; color: var(--muted); white-space: nowrap; }
  .controls input[type="range"] { flex: 1; min-width: 140px; accent-color: var(--cyan); }
  .n-value { font-size: 13px; font-weight: 700; color: var(--cyan); min-width: 50px; text-align: right; }
  .buttons { display: flex; gap: 8px; margin-left: auto; }
  button {
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 9px 14px;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid var(--border);
    background: #1c2530;
    color: var(--text);
  }
  button:disabled { opacity: 0.5; cursor: default; }
  button.before { border-color: var(--red-border); color: var(--red); }
  button.after { border-color: var(--green-border); color: var(--green); }

  .panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 18px;
    margin-bottom: 14px;
  }
  .panel-title { font-size: 13px; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 12px; }
  .panel-title.before { color: var(--red); }
  .panel-title.after { color: var(--cyan); }

  .stat-row { display: flex; gap: 8px; margin-bottom: 10px; }
  .stat {
    flex: 1;
    background: #1c2530;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 11px;
    color: var(--muted);
    text-align: center;
  }
  .stat b { display: block; font-size: 16px; margin-top: 2px; }
  .stat b.before { color: var(--red); }
  .stat b.after { color: var(--green); }

  .stage {
    position: relative;
    height: 150px;
    background: #0f151c;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 10px;
  }
  .stage-label {
    position: absolute;
    font-size: 10px;
    color: #5b6b7d;
    letter-spacing: 0.5px;
  }
  .source-label { top: 8px; left: 14px; }
  .target-label { top: 8px; right: 20px; text-align: right; }

  .box {
    position: absolute;
    right: 20px;
    top: 34px;
    width: 92px;
    height: 92px;
    border-radius: 10px;
    background: #1c2530;
    border: 2px dashed #3a4656;
    transition: border-color 0.2s, background 0.2s;
  }
  .box.lit.before { border-color: var(--red-border); background: #23181a; }
  .box.lit.after { border-color: var(--green-border); background: #16261f; }

  .dot {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #3a4656;
    border: 1px solid #5b6b7d;
    transition: transform 0.35s ease, background 0.12s ease, border-color 0.12s ease;
  }
  .dot.converted { background: #ff6ec7; border-color: #ff6ec7; }
  .dot.before-landed { background: var(--red); border-color: var(--red); box-shadow: none; }
  .dot.after-landed { background: var(--green); border-color: var(--green); box-shadow: none; }

  .result { font-size: 12px; color: var(--muted); margin-top: 4px; min-height: 16px; }
  .result b { font-size: 14px; }
  .result b.before { color: var(--red); }
  .result b.after { color: var(--green); }

  .note { font-size: 11px; color: #5b6b7d; margin-top: 4px; line-height: 1.6; }
</style>
</head>
<body>
<div class="wrap">
  <h1>터치다운 저장 방식 비교 — 좌표가 러닝 기록에 붙는 모습</h1>

  <div class="controls">
    <label for="nSlider">좌표 개수 (N)</label>
    <input type="range" id="nSlider" min="4" max="16" step="1" value="8">
    <span class="n-value" id="nValue">8개</span>
    <div class="buttons">
      <button class="before" id="runBefore">BEFORE 실행</button>
      <button class="after" id="runAfter">AFTER 실행</button>
    </div>
  </div>

  <div class="panel">
    <div class="panel-title before">BEFORE — 좌표마다 변환하고, 그때그때 하나씩 붙임</div>
    <div class="stat-row">
      <div class="stat">변환 횟수<b class="before" id="beforeConvertCount">0</b></div>
      <div class="stat">붙이기 횟수<b class="before" id="beforeAttachCount">0</b></div>
    </div>
    <div class="stage" id="beforeStage">
      <span class="stage-label source-label">좌표 원본 배열</span>
      <span class="stage-label target-label">러닝 기록<br>.coordinates</span>
      <div class="box" id="beforeBox"></div>
    </div>
    <div class="result" id="beforeResult">대기 중 — BEFORE 실행을 눌러보세요.</div>
  </div>

  <div class="panel">
    <div class="panel-title after">AFTER — 변환은 하되, 붙이기는 다 모아서 한 번만</div>
    <div class="stat-row">
      <div class="stat">변환 횟수<b class="after" id="afterConvertCount">0</b></div>
      <div class="stat">붙이기 횟수<b class="after" id="afterAttachCount">0</b></div>
    </div>
    <div class="stage" id="afterStage">
      <span class="stage-label source-label">좌표 원본 배열</span>
      <span class="stage-label target-label">러닝 기록<br>.coordinates</span>
      <div class="box" id="afterBox"></div>
    </div>
    <div class="result" id="afterResult">대기 중 — AFTER 실행을 눌러보세요.</div>
  </div>

  <div class="note">
    회색 = 아직 변환 전인 원본 좌표, 분홍 = SwiftDataCoordinate로 변환됨, 빨강/초록 = 러닝 기록에 붙음(붙이기 완료). 작은 N으로 실제 움직임을 보여주는 시각화입니다. 실제 10km 러닝이면 좌표가 2000개쯤 쌓이는데, 그 규모에서는 붙이기 한 번당 걸리는 시간이 아주 짧아도 BEFORE는 그걸 2000번 반복하니 다 더하면 체감될 정도로 느려지고, AFTER는 몇 번을 뛰든 붙이기가 딱 한 번이라 거의 그대로입니다.
  </div>
</div>

<script>
  const nSlider = document.getElementById('nSlider');
  const nValue = document.getElementById('nValue');
  const runBeforeBtn = document.getElementById('runBefore');
  const runAfterBtn = document.getElementById('runAfter');

  const beforeStage = document.getElementById('beforeStage');
  const beforeBox = document.getElementById('beforeBox');
  const beforeResult = document.getElementById('beforeResult');
  const beforeConvertCount = document.getElementById('beforeConvertCount');
  const beforeAttachCount = document.getElementById('beforeAttachCount');

  const afterStage = document.getElementById('afterStage');
  const afterBox = document.getElementById('afterBox');
  const afterResult = document.getElementById('afterResult');
  const afterConvertCount = document.getElementById('afterConvertCount');
  const afterAttachCount = document.getElementById('afterAttachCount');

  const FLASH_MS = 220; // "변환" 표시(색 반짝임)가 유지되는 시간
  const MOVE_MS = 350;  // "붙이기" 이동 애니메이션 시간
  const STEP_MS = FLASH_MS + MOVE_MS; // BEFORE에서 좌표 하나의 변환+붙이기 한 사이클 시간
  const AFTER_FLASH_HOLD_MS = 300; // AFTER에서 전체가 변환 표시된 채 대기하는 시간

  function updateNLabel() {
    nValue.textContent = nSlider.value + '개';
  }
  nSlider.addEventListener('input', () => {
    updateNLabel();
    layoutDots(beforeStage, 'before');
    layoutDots(afterStage, 'after');
  });
  updateNLabel();

  function setControlsDisabled(disabled) {
    runBeforeBtn.disabled = disabled;
    runAfterBtn.disabled = disabled;
    nSlider.disabled = disabled;
  }

  function layoutDots(stage, mode) {
    stage.querySelectorAll('.dot').forEach(d => d.remove());
    const n = parseInt(nSlider.value, 10);
    const box = mode === 'before' ? beforeBox : afterBox;
    box.classList.remove('lit', 'before', 'after');

    const cols = Math.ceil(n / 2);
    const spacing = 26;
    const startX = 16;
    const startY = 40;

    const dots = [];
    for (let i = 0; i < n; i++) {
      const dot = document.createElement('div');
      dot.className = 'dot';
      const row = Math.floor(i / cols);
      const col = i % cols;
      const x = startX + col * spacing;
      const y = startY + row * spacing;
      dot.style.left = x + 'px';
      dot.style.top = y + 'px';
      dot.style.transitionDelay = '0ms';
      stage.appendChild(dot);
      dots.push(dot);
    }
    return dots;
  }

  let beforeDots = layoutDots(beforeStage, 'before');
  let afterDots = layoutDots(afterStage, 'after');

  function boxTarget(stage, box) {
    const stageRect = stage.getBoundingClientRect();
    const boxRect = box.getBoundingClientRect();
    return {
      x: (boxRect.left - stageRect.left) + boxRect.width / 2 - 7,
      y: (boxRect.top - stageRect.top) + boxRect.height / 2 - 7
    };
  }

  function runBeforeAnim() {
    setControlsDisabled(true);
    beforeResult.textContent = '';
    beforeConvertCount.textContent = '0';
    beforeAttachCount.textContent = '0';
    beforeBox.classList.remove('lit');
    const dots = layoutDots(beforeStage, 'before');
    const n = dots.length;
    const target = boxTarget(beforeStage, beforeBox);

    dots.forEach((dot, i) => {
      const flashAt = i * STEP_MS;
      const moveAt = flashAt + FLASH_MS;

      // 1단계: 변환 — 색만 반짝, 아직 움직이지 않음
      setTimeout(() => {
        dot.classList.add('converted');
        beforeConvertCount.textContent = i + 1;
      }, flashAt);

      // 2단계: 붙이기 — 변환 직후 곧바로 박스로 이동
      setTimeout(() => {
        dot.classList.remove('converted');
        const dx = target.x - parseFloat(dot.style.left);
        const dy = target.y - parseFloat(dot.style.top);
        dot.style.transform = `translate(${dx}px, ${dy}px)`;
        dot.classList.add('before-landed');
        beforeAttachCount.textContent = i + 1;
        beforeBox.classList.add('lit', 'before');

        if (i === n - 1) {
          setTimeout(() => {
            const totalMs = (n - 1) * STEP_MS + FLASH_MS + MOVE_MS;
            beforeResult.innerHTML = `변환 <b class="before">${n}번</b> + 붙이기 <b class="before">${n}번</b> — 좌표 하나 변환하자마자 바로 붙이고, 다음 좌표로 (총 ${totalMs}ms)`;
            setControlsDisabled(false);
          }, MOVE_MS);
        }
      }, moveAt);
    });
  }

  function runAfterAnim() {
    setControlsDisabled(true);
    afterResult.textContent = '';
    afterConvertCount.textContent = '0';
    afterAttachCount.textContent = '0';
    afterBox.classList.remove('lit');
    const dots = layoutDots(afterStage, 'after');
    const n = dots.length;
    const target = boxTarget(afterStage, afterBox);

    // 1단계: 전부 동시에 변환 — 아직 움직이지 않음
    dots.forEach((dot) => dot.classList.add('converted'));
    afterConvertCount.textContent = n;

    setTimeout(() => {
      // 2단계: 다 변환된 걸 확인하고, 한꺼번에 박스로 이동 (붙이기 1번)
      dots.forEach((dot) => {
        dot.classList.remove('converted');
        const dx = target.x - parseFloat(dot.style.left);
        const dy = target.y - parseFloat(dot.style.top);
        dot.style.transform = `translate(${dx}px, ${dy}px)`;
        dot.classList.add('after-landed');
      });
      afterBox.classList.add('lit', 'after');

      setTimeout(() => {
        afterAttachCount.textContent = '1';
        afterResult.innerHTML = `변환 <b class="after">${n}번</b> + 붙이기 <b class="after">1번</b> — 다 변환해두고, 배열째로 한 번에 붙였다 (총 ${AFTER_FLASH_HOLD_MS + MOVE_MS}ms)`;
        setControlsDisabled(false);
      }, MOVE_MS);
    }, AFTER_FLASH_HOLD_MS);
  }

  runBeforeBtn.addEventListener('click', runBeforeAnim);
  runAfterBtn.addEventListener('click', runAfterAnim);
</script>
</body>
</html>
</file>

<file path="assets/demo/watch_data_lifecycle_simulator.html">
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Watch Data Lifecycle Simulator</title>
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#ffffff; --panel:#f7f8fa; --line:#e3e6ea; --ink:#16181d; --dim:#6b7280;
    --faint:#9aa1ab; --bad:#d0392b; --bad-bg:#fbeae8; --ok:#0d9276; --ok-bg:#e2f4ef;
    --mark:#2563eb; --mark-bg:#e8effc; --warn:#b45309;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:#09090b; --panel:#141417; --line:#27272a; --ink:#f4f4f5; --dim:#a1a1aa;
      --faint:#71717a; --bad:#f87171; --bad-bg:#331416; --ok:#34d399; --ok-bg:#0d2b23;
      --mark:#60a5fa; --mark-bg:#14203a; --warn:#fbbf24;
    }
  }
  * { box-sizing:border-box; }
  body { margin:0; padding:16px; background:var(--bg); color:var(--ink);
    font-family:'Inter',-apple-system,'Apple SD Gothic Neo',sans-serif;
    user-select:none; -webkit-user-select:none; }
  h1 { font-size:15px; font-weight:700; margin:0 0 5px; }
  .lead { font-size:12.5px; line-height:1.6; color:var(--dim); margin:0 0 14px; max-width:66ch; }
  .lead code { font-family:'Fira Code',monospace; font-size:11.5px; background:var(--panel); padding:1px 5px; border-radius:4px; }

  .bar { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:10px; }
  .bar > span { font-family:'Fira Code',monospace; font-size:10px; letter-spacing:.04em;
    color:var(--faint); text-transform:uppercase; margin-right:2px; }
  .seg { display:flex; border:1px solid var(--line); border-radius:7px; overflow:hidden; }
  .seg button { border:none; background:var(--bg); color:var(--dim); cursor:pointer;
    font-family:'Fira Code',monospace; font-size:11.5px; font-weight:500; padding:9px 13px;
    border-right:1px solid var(--line); transition:background .13s,color .13s; }
  .seg button:last-child { border-right:none; }
  .seg button[aria-pressed="true"] { background:var(--ok); color:var(--bg); font-weight:600; }
  .seg button.danger[aria-pressed="true"] { background:var(--bad); }
  .btn { border:1px solid var(--line); background:var(--panel); color:var(--ink); cursor:pointer;
    font-family:'Fira Code',monospace; font-size:11.5px; padding:9px 13px; border-radius:7px; }
  .btn.primary { background:var(--ok); border-color:var(--ok); color:var(--bg); font-weight:600; }
  .sp { flex:1 1 6px; }

  .row { display:grid; grid-template-columns:repeat(4,1fr); gap:7px; margin:12px 0; }
  .cell { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:9px 10px; min-width:0; }
  .cell .k { font-family:'Fira Code',monospace; font-size:8.5px; letter-spacing:.04em; text-transform:uppercase; color:var(--faint); }
  .cell .v { font-family:'Fira Code',monospace; font-size:12.5px; font-weight:600; margin-top:5px; }
  .cell.on { background:var(--ok-bg); border-color:var(--ok); }
  .cell.on .v { color:var(--ok); }
  .cell.off .v { color:var(--faint); }
  .cell.alarm { background:var(--bad-bg); border-color:var(--bad); }
  .cell.alarm .v { color:var(--bad); }
  @media (max-width:560px){ .row{grid-template-columns:repeat(2,1fr);} }

  .steps { display:flex; flex-direction:column; gap:5px; }
  .st { display:flex; gap:9px; align-items:flex-start; padding:7px 10px; border-radius:7px;
    border:1px solid var(--line); background:var(--panel); font-size:12px; line-height:1.5; color:var(--faint); }
  .st .n { font-family:'Fira Code',monospace; font-size:10px; font-weight:600; min-width:15px;
    padding-top:2px; color:var(--faint); }
  .st.done { color:var(--dim); }
  .st.done .n { color:var(--mark); }
  .st.now { background:var(--mark-bg); border-color:var(--mark); color:var(--ink); }
  .st.now .n { color:var(--mark); }
  .st.skip { opacity:.5; }
  .st.fail { background:var(--bad-bg); border-color:var(--bad); color:var(--ink); }
  .st.fail .n { color:var(--bad); }
  .st b { font-weight:600; color:var(--ink); }
  .st code { font-family:'Fira Code',monospace; font-size:11px; }

  .note { margin-top:12px; font-size:12.5px; line-height:1.65; color:var(--dim); border-left:2px solid var(--line); padding-left:12px; }
  .note b { color:var(--ink); font-weight:600; }
  .note.alarm { border-left-color:var(--bad); }
  .note.fine { border-left-color:var(--ok); }
</style>
</head>
<body>

<h1>화면이 한 번도 안 떴는데 기록이 저장되려면</h1>
<p class="lead">워치가 <code>transferUserInfo</code>로 기록을 보내면, 아이폰 앱이 꺼져 있어도 iOS가 앱을 잠깐 실행시켜 그 기록을 넘겨준다. 문제는 이때 <b>화면(<code>HomeView</code>)은 한 번도 안 뜬다</b>는 것이다.</p>

<div class="bar">
  <span>저장 통로</span>
  <div class="seg" id="seg-mode">
    <button type="button" class="danger" data-mode="before" aria-pressed="true">수정 전 (화면이 저장)</button>
    <button type="button" data-mode="after" aria-pressed="false">수정 후 (받는 즉시 저장)</button>
  </div>
</div>
<div class="bar">
  <span>아이폰 상태</span>
  <div class="seg" id="seg-state">
    <button type="button" data-state="terminated" aria-pressed="true">완전히 종료됨</button>
    <button type="button" data-state="suspended" aria-pressed="false">백그라운드 정지</button>
  </div>
  <span class="sp"></span>
  <button type="button" class="btn" id="reset">처음으로</button>
  <button type="button" class="btn" id="step">다음 단계</button>
  <button type="button" class="btn primary" id="play">재생</button>
</div>

<div class="row">
  <div class="cell"><div class="k">앱 프로세스</div><div class="v" id="v-proc">--</div></div>
  <div class="cell"><div class="k">modelContext</div><div class="v" id="v-ctx">--</div></div>
  <div class="cell"><div class="k">메모리 대기열</div><div class="v" id="v-mem">--</div></div>
  <div class="cell"><div class="k">디스크에 저장</div><div class="v" id="v-disk">--</div></div>
</div>

<div class="steps" id="steps"></div>
<div class="note" id="note">"다음 단계"를 눌러 무슨 일이 벌어지는지 따라가 보자.</div>

<script>
(function () {
  "use strict";
  var mode = "before", appState = "terminated", i = -1, timer = null;

  function plan() {
    var terminated = appState === "terminated";
    var s = [];
    s.push({ t: "워치가 러닝을 끝내고 <code>transferUserInfo</code>로 기록을 보낸다. 이 통로는 아이폰 앱이 꺼져 있어도 시스템 큐에 남는다." });

    if (terminated) {
      s.push({ t: "아이폰 앱이 메모리에 없다. iOS가 <b>프로세스를 새로 만들어</b> <code>RunWayApp.init()</code>부터 실행한다." });
      s.push({
        t: mode === "after"
          ? "<code>init()</code>에서 <code>RunViewModel</code>을 만들고 <b><code>modelContext</code>까지 그 자리에서 넣어준다.</b>"
          : "<code>init()</code>에서 <code>RunViewModel</code>은 만들어지지만, <code>modelContext</code>는 <code>HomeView</code>가 떠야 들어간다. <b>지금은 비어 있다.</b>",
        ctx: mode === "after"
      });
    } else {
      s.push({ t: "앱 프로세스가 메모리에 그대로 남아 있다. 예전에 앱을 열었을 때 준비된 것들이 그대로 얼어 있다." });
      s.push({ t: "<code>RunViewModel</code>도 <code>modelContext</code>도 그때 이미 채워져 있다.", ctx: true });
    }

    s.push({ t: "<code>WCSession.activate()</code>가 끝나고, iOS가 <code>didReceiveUserInfo</code> 콜백을 부른다." });

    var hasCtx = terminated ? (mode === "after") : true;
    if (mode === "after") {
      s.push({
        t: hasCtx
          ? "<code>saveIncomingWatchFlight()</code>가 곧바로 <code>insert</code> + <code>save()</code>를 한다. <b>이 순간 디스크에 들어간다.</b>"
          : "<code>modelContext</code>가 없어 안전망인 메모리 대기열로 빠진다.",
        disk: hasCtx, mem: !hasCtx
      });
    } else {
      s.push({ t: "받은 기록을 <code>pendingWatchDataQueue</code>라는 <b>메모리 배열에만</b> 담아둔다. 아직 디스크에는 아무것도 안 썼다.", mem: true });
    }

    s.push({ t: "여기서 <code>HomeView</code>가 뜨기를 기다려야 저장이 이어진다. 그런데 <b>백그라운드로만 깨운 실행이라 화면은 뜨지 않는다.</b>" });
    if (terminated) {
      s.push({ t: "iOS가 할 일이 끝났다고 보고 <b>프로세스를 정리한다.</b> 메모리에만 있던 건 전부 사라진다.", kill: true });
    } else {
      s.push({ t: "앱은 다시 정지 상태로 돌아간다. <b>프로세스가 메모리에 남아 있으니</b> 대기열도 같이 살아남는다.", park: true });
    }
    return s;
  }

  function stateAt(upto) {
    var st = { proc: appState === "terminated" ? "없음" : "살아 있음", ctx: appState === "terminated" ? "비어 있음" : "준비됨",
               mem: 0, disk: 0, killed: false };
    var steps = plan();
    for (var k = 0; k <= upto && k < steps.length; k++) {
      var s = steps[k];
      if (k === 1 && appState === "terminated") st.proc = "새로 시작됨";
      if (s.ctx) st.ctx = "준비됨";
      if (s.mem) st.mem = 1;
      if (s.disk) st.disk = 1;
      if (s.kill) {
        st.proc = "정리됨"; st.ctx = "사라짐";
        if (st.mem) { st.mem = 0; st.lost = true; }
      }
      if (s.park) { st.parked = true; }
    }
    return st;
  }

  function render() {
    var steps = plan();
    var st = i >= 0 ? stateAt(i) : stateAt(-1);
    var set = function (id, v, cls) {
      var e = document.getElementById(id); e.textContent = v;
      e.parentElement.className = "cell" + (cls ? " " + cls : "");
    };
    set("v-proc", st.proc, (st.proc === "정리됨" || st.proc === "없음") ? "off" : "on");
    set("v-ctx", st.ctx, st.ctx === "준비됨" ? "on" : "off");
    set("v-mem", st.mem ? "기록 1건" : (st.lost ? "잃어버림" : "없음"), st.lost ? "alarm" : (st.mem ? "" : "off"));
    set("v-disk", st.disk ? "기록 1건" : "없음", st.disk ? "on" : ((i >= steps.length - 1 && !st.mem) ? "alarm" : "off"));

    document.getElementById("steps").innerHTML = steps.map(function (s, k) {
      var cls = "st";
      if (k < i) cls += " done";
      else if (k === i) cls += " now";
      else cls += " skip";
      if (k === i && s.kill && st.lost) cls = "st fail";
      return '<div class="' + cls + '"><span class="n">' + (k + 1) + '</span><span>' + s.t + '</span></div>';
    }).join("");

    var note = document.getElementById("note");
    if (i < 0) { note.className = "note"; note.textContent = "\"다음 단계\"를 눌러 무슨 일이 벌어지는지 따라가 보자."; return; }
    if (i < steps.length - 1) {
      note.className = "note";
      note.innerHTML = "아직 진행 중이다. <b>디스크에 저장</b> 칸이 언제 채워지는지를 눈여겨보자.";
      return;
    }
    if (st.disk) {
      note.className = "note fine";
      note.innerHTML = "화면이 한 번도 안 떴는데 기록은 <b>이미 디스크에 있다.</b> 저장이 <code>HomeView</code>가 아니라 기록을 받는 그 자리에서 일어났기 때문이다. 나중에 앱을 열면 로그북에 그냥 들어와 있다.";
    } else if (st.lost) {
      note.className = "note alarm";
      note.innerHTML = "전송은 성공했는데 <b>기록이 사라졌다.</b> 저장을 <code>HomeView</code>에 맡겨뒀는데 그 화면이 뜰 일이 없었기 때문이다. 유저 입장에서는 아무 에러도 없이 그냥 기록이 없다.";
    } else if (st.mem) {
      note.className = "note";
      note.innerHTML = "이 경우엔 사라지지는 않았다. 프로세스가 살아 있어서 대기열도 남아 있고, <b>다음에 앱을 직접 열면</b> 그때 <code>HomeView</code>가 뜨면서 저장된다. 원래 버그가 <b>완전히 종료된 상태에서만</b> 터졌던 이유가 이거다.";
    } else {
      note.className = "note alarm";
      note.innerHTML = "디스크에 아무것도 안 남았다.";
    }
  }

  function stop(){ if(timer){clearInterval(timer);timer=null;} document.getElementById("play").textContent="재생"; }
  function step(){ var n=plan().length; if(i>=n-1){stop();return;} i++; render(); }
  document.getElementById("step").addEventListener("click",function(){stop();step();});
  document.getElementById("reset").addEventListener("click",function(){stop();i=-1;render();});
  document.getElementById("play").addEventListener("click",function(){
    if(timer){stop();return;}
    if(i>=plan().length-1) i=-1;
    this.textContent="일시정지"; step(); timer=setInterval(step,1500);
  });
  function wire(sel, key) {
    document.querySelectorAll(sel + " button").forEach(function (b) {
      b.addEventListener("click", function () {
        if (key === "mode") mode = b.dataset.mode; else appState = b.dataset.state;
        document.querySelectorAll(sel + " button").forEach(function (x) { x.setAttribute("aria-pressed", String(x === b)); });
        stop(); i = -1; render();
      });
    });
  }
  wire("#seg-mode", "mode"); wire("#seg-state", "state");
  render();
})();
</script>
