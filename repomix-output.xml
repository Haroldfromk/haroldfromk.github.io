```swift
class ButtonFactory {
    
    func makeButton(title: String, color: UIColor = .black, backgroundColor: UIColor = .lightGray, completion: @escaping (UIAction) -> Void) -> UIButton {
        let button = UIButton()
        button.setTitle(title, for: .normal)
