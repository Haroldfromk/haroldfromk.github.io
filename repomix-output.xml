<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>지갑 재진입 타임라인</title>
<style>
  :root {
    --bg: #f5f5f7; --card: #ffffff; --text: #1d1d1f; --sub: #6e6e73; --line: #d9dbe3;
    --a: #4a6fa5; --a-soft: #dbe8fb; --b: #c46a1c; --b-soft: #fdebd6;
    --gap: #aab1c2; --gap-soft: rgba(170,177,194,0.22);
    --good: #2e9e4f; --good-soft: #e5f4ea; --bad: #e5534b; --bad-soft: #fbecec; --warn: #b7860b;
    --seg: #e8e8ed; --seg-on: #ffffff; --head: #e5534b;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1c1e; --card: #2c2c2e; --text: #f5f5f7; --sub: #a1a1a6; --line: #3a3a3c;
      --a: #7aa2de; --a-soft: #22334d; --b: #e89650; --b-soft: #4a3220;
      --gap: #6e7384; --gap-soft: rgba(142,148,166,0.18);
      --good: #4cc26e; --good-soft: #1f3a28; --bad: #ff6b63; --bad-soft: #4a2323; --warn: #e3b341;
      --seg: #3a3a3c; --seg-on: #5a5a5e; --head: #ff6b63;
    }
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text);
    font-family: -apple-system, "Apple SD Gothic Neo", sans-serif; overflow: hidden; }
