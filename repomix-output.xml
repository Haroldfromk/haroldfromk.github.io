회원탈퇴는 다음과 같은 분기 흐름으로 구성됨:

```swift
if let user = Auth.auth().currentUser {
    for provider in user.providerData {
        switch provider.providerID {
        case "apple.com":
            // Apple refreshToken revoke 후 삭제
        case "google.com":
            // Google reauthenticate 후 삭제
        default:
            break
        }
    }
}
```

