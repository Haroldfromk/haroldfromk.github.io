    func operation (first : Int, second : Int) {
        print(first * second)
    }
}

// MARK: - 나눗셈
class DivideOperation  {
    func operation (first : Int, second : Int) {
        print(first / second)
    }
}

// MARK: - 나머지
class ModOperation {
    func operation (first : Int, second : Int) {
        print(first % second)
    }
}

// MARK: - Test
let calculator = Calculator()
