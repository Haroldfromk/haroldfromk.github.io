        .subtitle { text-align: center; font-size: 13px; color: #86868b; margin-bottom: 20px; }
        
        /* ⏳ 1. Task 보류실 */
        .suspension-zone { background: #fff2e0; border: 2px dashed #ff9500; border-radius: 10px; padding: 12px; margin-bottom: 14px; box-sizing: border-box; }
        .zone-title { font-size: 11px; font-weight: bold; color: #ff9500; font-family: monospace; margin-bottom: 4px; text-transform: uppercase; }
        .suspend-card { display: inline-block; background: #ff9500; color: white; padding: 6px 12px; border-radius: 5px; font-size: 11px; font-weight: bold; font-family: monospace; display: none; }

        /* 🌐 2. 가독성 개선된 백그라운드 네트워크 채널 */
        .network-pipeline { background: #f0f4ff; border: 2px solid #5856d6; border-radius: 10px; padding: 14px 16px; margin-bottom: 14px; min-height: 76px; box-sizing: border-box; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; }
        .net-title { font-size: 11px; font-weight: bold; color: #5856d6; font-family: monospace; text-transform: uppercase; }
        
        /* 📝 상태 고정 텍스트 영역 (눈이 편안함) */
        .net-status-text { font-size: 12px; font-family: monospace; font-weight: bold; color: #1c1c1e; margin-top: 4px; z-index: 2; }
        
        /* ⚡ 움직이는 순수 데이터 패킷 레일 (글자 없이 그래픽만 무빙) */
        .packet-rail { width: 100%; height: 12px; background: rgba(88,86,214,0.1); border-radius: 6px; position: relative; overflow: hidden; margin-top: 8px; display: none; }
        .packet-dot { position: absolute; width: 40px; height: 100%; background: #5856d6; border-radius: 6px; left: -50px; box-shadow: 0 0 8px #5856d6; }
        .packet-dot.running { animation: bulletFlow 1.4s linear infinite; }
        @keyframes bulletFlow { 0% { left: -50px; } 100% { left: 100%; } }

        /* 📱 3. 가상 아이폰 스크린 모니터 */
        .app-monitor { background: #2c2c2e; border-radius: 12px; padding: 16px; color: #fff; margin-bottom: 14px; border: 1px solid #3a3a3c; width: 100%; box-sizing: border-box; }
        .monitor-title { font-size: 11px; color: #aeaeb2; font-family: monospace; margin-bottom: 10px; display: flex; justify-content: space-between; font-weight: bold; }
        .screen-view { background: #1c1c1e; border-radius: 10px; padding: 14px; height: 150px; display: flex; flex-direction: column; gap: 10px; box-sizing: border-box; }
        
        .component-box { background: #2c2c2e; border-radius: 8px; padding: 10px; font-size: 12px; font-family: monospace; border: 1px solid #3a3a3c; min-height: 48px; box-sizing: border-box; transition: all 0.3s; }
        .component-box.highlight-green { border-color: #34c759; background: rgba(52,199,89,0.05); }
        .component-box.highlight-blue { border-color: #0071e3; background: rgba(0,113,227,0.05); }
        .comp-title { font-size: 10px; color: #86868b; font-weight: bold; margin-bottom: 4px; }
        .user-chip { display: inline-block; background: #0071e3; color: white; padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; animation: popIn 0.3s ease-out forwards; }
        
        /* 🧵 4. 메인 스레드 궤적 상태 */
        .thread-track { background: #1c1c1e; border-radius: 8px; padding: 12px; color: white; font-size: 12px; font-family: monospace; display: flex; justify-content: space-between; align-items: center; width: 100%; box-sizing: border-box; }

        .action-btn { width: 100%; background: #1d1d1f; color: white; border: none; padding: 14px; font-size: 14px; font-weight: 600; border-radius: 8px; cursor: pointer; margin-top: 14px; }
