```swift
func addDB (textfield : String ) {
        let dateFormat = DateFormatter()
        dateFormat.dateFormat = "yyyy-MM-dd"
        dbModel.db.collection(Constants.collectionName).addDocument(data: [Constants.Fire.fireId : self.getID()
