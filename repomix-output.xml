  .l-task .lname { color: var(--task); } .l-thread .lname { color: var(--thread); } .l-core .lname { color: var(--core); }
  .boxes { flex: 1; display: flex; gap: 8px; min-width: 0; }

  .zone { flex: 1; min-width: 0; background: var(--zone); border: 1px dashed var(--line); border-radius: 10px; padding: 6px 8px 8px; }
