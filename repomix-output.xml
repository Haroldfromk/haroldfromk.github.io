            VStack {
                ScrollImage(image: "bellagio")
                
                ScrollImage(image: "excalibur")
                
                ScrollImage(image: "luxor")
                
                ScrollImage(image: "paris")
                
                ScrollImage(image: "stratosphere")
                
                ScrollImage(image: "treasureisland")
            }
            .padding()
        }
    }
}

```

![Sep-06-2024 14-09-04](https://pub-1fd8ca6711bd4f3f8b74d88a697b50f9.r2.dev/2024-07-19-ScrollView/f1e00330-2c97-4c2e-8c3b-954e1a8e28bb.png)

