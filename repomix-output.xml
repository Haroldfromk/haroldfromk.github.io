            if let erorr = error {
                print (erorr.localizedDescription)
                return
            }
            
            ref.downloadURL { url, error in
                if let erorr = error {
                    print (erorr.localizedDescription)
                    return
                }
                
                guard let fileURL = url?.absoluteString else { return }
                completion(fileURL)
            }
            
        
        }
    }
    
}

