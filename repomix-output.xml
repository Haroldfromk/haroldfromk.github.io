<body>

<div class="container">
    <h3>Combine Collect 시뮬레이터</h3>
    <button id="sendBtn">💥 데이터 전송 (현재 값: 1)</button>
    
    <div class="timer-zone">
        <span id="timerText">⏳ 수집 주기: 4.0초</span>
        <div class="progress-bar">
            <div class="progress-fill" id="progressFill"></div>
        </div>
    </div>
    
    <div class="board">
        <div class="row">
            <span class="label time-label">⏱️ collect(.byTime(4초)) -> 일괄 저장 배열</span>
            <span id="timeResult">현재 보관고: []</span>
        </div>
        <hr style="border: 0; border-top: 1px solid #d2d2d7; margin: 8px 0;">
        <div class="row">
            <span class="label count-label">🔢 collect(3) -> 3개 찰 때마다 방출</span>
            <span id="countResult">현재 보관고: []</span>
        </div>
    </div>
    <button class="reset-btn" id="resetBtn">시뮬레이터 리셋</button>
</div>

<script>
    let clickCount = 0;
    let timeQueue = [];
    let countQueue = [];
    
    let timeLeft = 40; 
    let timerInterval = null;

    const sendBtn = document.getElementById('sendBtn');
    const timeResult = document.getElementById('timeResult');
    const countResult = document.getElementById('countResult');
    const resetBtn = document.getElementById('resetBtn');
    const timerText = document.getElementById('timerText');
    const progressFill = document.getElementById('progressFill');

    function startTimer() {
        timerInterval = setInterval(() => {
            timeLeft--;
            if (timeLeft >= 0) {
                timerText.innerText = `⏳ 수집 주기: ${(timeLeft / 10).toFixed(1)}초`;
                progressFill.style.width = `${(timeLeft / 40) * 100}%`;
            }
            
            if (timeLeft === 0) {
                // 4초 만료 -> 수집된 배열을 통째로 방출하고 초기화
                timeResult.innerHTML = `📦 방출됨! <span class="result-val">[${timeQueue.join(', ')}]</span>`;
                timeQueue = [];
                
                // 타이머 리셋 후 다시 돌기
                timeLeft = 40;
                progressFill.style.width = '100%';
            }
        }, 100);
    }

    sendBtn.addEventListener('click', () => {
        clickCount++;
        sendBtn.innerText = `💥 데이터 전송 (현재 값: ${clickCount + 1})`;
        
        // 양쪽 바구니에 일단 다 주입
        timeQueue.push(clickCount);
        countQueue.push(clickCount);
        
        // 1. byTime 화면 갱신 (대기 중인 상태 보여주기)
        if (timeLeft > 0) {
            timeResult.innerText = `📥 수집 중... [${timeQueue.join(', ')}]`;
        }
        
        // 2. count(3) 로직 제어
        if (countQueue.length === 3) {
            countResult.innerHTML = `📦 방출됨! <span class="result-val">[${countQueue.join(', ')}]</span>`;
            countQueue = [];
        } else {
            countResult.innerText = `📥 수집 중... [${countQueue.join(', ')}] (현재 ${countQueue.length}/3)`;
        }
    });

    resetBtn.addEventListener('click', () => {
        clickCount = 0;
        timeQueue = [];
        countQueue = [];
        timeLeft = 40;
        sendBtn.innerText = `💥 데이터 전송 (현재 값: 1)`;
        timerText.innerText = `⏳ 수집 주기: 4.0초`;
        progressFill.style.width = '100%';
        timeResult.innerText = '현재 보관고: []';
        countResult.innerText = '현재 보관고: []';
    });

    // 시작하자마자 4초 타이머 무한 루프 가동
    startTimer();
</script>

</body>
</html>
