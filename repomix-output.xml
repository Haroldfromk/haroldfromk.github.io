<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root {
    --bg: #0b0f14;
    --panel: #141a22;
    --panel2: #1c2530;
    --border: #2a3542;
    --muted: #8a95a3;
    --dim: #5d6876;
    --text: #c7d0da;
    --cyan: #3fe6c4;
    --amber: #ffb84d;
    --red: #ff6b6b;
    --red-border: #7a2a2a;
    --green: #7ff0d4;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    padding: 18px 16px;
  }
  .wrap { max-width: 820px; margin: 0 auto; }
  h1 { font-size: 15px; color: var(--cyan); letter-spacing: 0.5px; margin: 0 0 4px; font-weight: 700; }
