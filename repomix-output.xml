  @media (max-width: 560px) {
    .seg button { font-size: 11px; padding: 7px 1px; }
    .desc { height: 34px; }
    .lname { width: 30px; font-size: 11px; }
    .zone { padding: 5px 5px 6px; }
    .zone .zt { font-size: 10px; white-space: normal; height: 26px; line-height: 13px; }
    .zone .hold { min-height: 58px; align-content: flex-start; }
    .slot { height: 86px; } .core { height: 46px; }
    .chip { width: 26px; height: 26px; font-size: 12px; }
    .slot .chip { width: 44px; height: 30px; }
    .slot, .core { padding: 5px 4px; }
    .slot .cap, .core .cap { font-size: 10px; }
    .msg { height: 78px; }
    .row { flex-direction: column; }
    .result { flex: none; height: 78px; }
    .ctrl .play { flex: 1; height: 40px; }
    .ctrl .step { height: 40px; }
  }
</style>
</head>
<body>
<div class="wrap">
  <h3>작업, 스레드, 코어는 어떻게 움직이나</h3>
  <div class="subtitle">작업은 스레드 위에서 돌고, 스레드는 코어 위에서 돈다</div>
  <div class="seg" id="tabs"></div>
  <div class="desc" id="desc"></div>
  <div class="card">
    <div class="clock" id="clock"></div>
    <div class="layer l-task">
      <div class="lname">작업</div>
      <div class="boxes">
        <div class="zone"><div class="zt">스레드 차례 기다림</div><div class="hold" data-z="queue"></div></div>
        <div class="zone"><div class="zt">await 중 (스레드를 양보함)</div><div class="hold" data-z="wait"></div></div>
        <div class="zone"><div class="zt">끝</div><div class="hold" data-z="done"></div></div>
      </div>
    </div>
    <div class="layer l-thread">
      <div class="lname">스레드</div>
      <div class="boxes" id="slots"></div>
    </div>
    <div class="layer l-core">
      <div class="lname">코어</div>
      <div class="boxes" id="cores"></div>
    </div>
    <div class="msg" id="msg"></div>
    <div class="note">움직이는 속도는 실제 시간 비율과 다르다. 오른쪽 위 시각은 실험에서 잰 값이다. 스레드가 어느 코어에 올라가는지는 OS가 정하고, 매번 같은 짝은 아니다.</div>
  </div>
  <div class="row">
    <div class="result" id="result"></div>
    <div class="ctrl">
      <button class="step" id="prev">◀</button>
      <button class="play" id="play">▶ 재생</button>
      <button class="step" id="next">▶</button>
    </div>
  </div>
</div>

<script>
// 위치: queue(차례 기다림) / wait(await 중) / done(끝) / 0, 1, 2(스레드 번호)
// 상태: run(실행 중) / hold(스레드를 붙잡고 기다림)
// 시각은 ConcurrencyLab Experiments/06-Blocking 실험 1(Task.sleep, usleep)과 실험 11(계산 3개)에서 잰 값이다.
const Q = { A: 'queue', B: 'queue', C: 'queue' };
const MODES = {
  sleep: {
    label: '동시성 · Task.sleep',
    desc: 'MainActor에서 300ms씩 기다리는 작업 셋. 쓸 수 있는 스레드는 메인 스레드 하나',
    threads: 1,
    steps: [
      { t: 0, pos: Q, msg: 'async let으로 작업 셋을 같이 출발시켰다. MainActor라서 쓸 수 있는 스레드는 메인 스레드 하나뿐이다.' },
      { t: 0, pos: { A: 0, B: 'queue', C: 'queue' }, run: 'A', msg: 'A가 스레드에 올라타 "시작"을 찍는다.' },
      { t: 0, pos: { A: 'wait', B: 0, C: 'queue' }, run: 'B', msg: 'A가 await Task.sleep에서 스레드를 양보하고 내려간다. 빈 자리에 B가 올라탄다.' },
      { t: 0, pos: { A: 'wait', B: 'wait', C: 0 }, run: 'C', msg: 'B도 await에서 내려가고, C가 올라탄다.' },
      { t: 0, pos: { A: 'wait', B: 'wait', C: 'wait' }, msg: '셋 다 await 중이다. 기다리는 작업은 스레드를 양보했으니 스레드는 비어 있다.' },
      { t: 317, pos: { A: 0, B: 'wait', C: 'wait' }, run: 'A', msg: '300ms가 지나 깨어난 작업부터 다시 올라탄다. 이번 실행에서는 A가 먼저였다.' },
      { t: 317, pos: { A: 'done', B: 'wait', C: 0 }, run: 'C', msg: 'A가 끝나고 C가 올라탄다. 깨어나는 순서는 정해져 있지 않다. 실행마다 A, B, C이기도 A, C, B이기도 했다.' },
      { t: 317, pos: { A: 'done', B: 0, C: 'done' }, run: 'B', msg: 'C가 끝나고 B가 올라탄다.' },
      { t: 317, pos: { A: 'done', B: 'done', C: 'done' }, msg: '셋 다 끝났다.' },
    ],
    result: '전체 317ms. 스레드 하나로 셋이 겹쳐서 돌았다. 한 순간에 스레드 위에 있던 작업은 항상 하나였다.',
  },
  block: {
    label: '동시성 · usleep',
    desc: '같은 작업 셋이 await 대신 usleep으로 300ms를 기다리면',
    threads: 1,
    steps: [
      { t: 0, pos: Q, msg: '같은 작업 셋이다. 이번엔 Task.sleep 대신 usleep으로 기다린다.' },
      { t: 0, pos: { A: 0, B: 'queue', C: 'queue' }, run: 'A', msg: 'A가 스레드에 올라타 "시작"을 찍는다.' },
      { t: 0, pos: { A: 0, B: 'queue', C: 'queue' }, hold: 'A', msg: 'A가 usleep으로 기다린다. await가 아니라서 스레드에서 내려가지 않는다. B와 C는 스레드가 빌 때까지 차례를 기다린다.' },
      { t: 150, pos: { A: 0, B: 'queue', C: 'queue' }, hold: 'A', msg: '잠든 건 스레드라서 코어는 쉰다(실행 중 CPU 사용 시간 0.00초). 그래도 MainActor는 이 스레드만 쓸 수 있어서 B와 C는 못 올라탄다.' },
      { t: 305, pos: { A: 'done', B: 0, C: 'queue' }, hold: 'B', msg: '305ms에 A가 끝나서야 B가 올라탄다. B도 usleep으로 스레드를 붙잡는다.' },
      { t: 612, pos: { A: 'done', B: 'done', C: 0 }, hold: 'C', msg: '612ms에 B가 끝나고 C 차례가 온다.' },
      { t: 917, pos: { A: 'done', B: 'done', C: 'done' }, msg: '셋 다 끝났다.' },
    ],
    result: '전체 917ms. 기다리는 동안 스레드를 붙잡아서 셋이 차례로 돌았다. 코어가 쉬고 있어도 올라탈 스레드가 없으면 못 쓴다.',
  },
  parallel: {
    label: '병렬성 · 계산 3개',
    desc: '기다리는 틈 없이 계산만 하는 작업 셋을 공용 스레드에서 돌리면',
    threads: 3,
    steps: [
      { t: 0, pos: Q, msg: '계산만 하는 작업 셋이다. 하나만 돌리면 약 510ms 걸린다.' },
      { t: 0, pos: { A: 0, B: 1, C: 2 }, run: 'ABC', msg: '셋이 서로 다른 스레드에 올라타고, 스레드 셋이 코어 셋에서 같은 순간에 돈다. 계산은 쉬는 틈이 없어서 스레드를 양보하지 않는다.' },
      { t: 569, pos: { A: 0, B: 1, C: 'done' }, run: 'AB', msg: 'C가 먼저 끝났다. 같이 출발해도 끝나는 순서는 정해져 있지 않다.' },
      { t: 576, pos: { A: 0, B: 'done', C: 'done' }, run: 'A', msg: '이어서 B가 끝났다.' },
      { t: 579, pos: { A: 'done', B: 'done', C: 'done' }, msg: '마지막으로 A가 끝났다.' },
    ],
    result: '전체 579ms. 셋을 같이 돌려도 하나일 때(약 510ms)와 비슷하게 끝났다. 차례로 돌렸다면 약 1.5초다. 10번 돌려 549~613ms, 스레드는 매번 3개였다.',
  },
};

let key = 'sleep', idx = 0, timer = null;
const chips = {};

function build() {
  const d = MODES[key];
  document.getElementById('slots').innerHTML = [0, 1, 2].slice(0, d.threads).map(i =>
    `<div class="slot"><div class="st">스레드 ${i + 1}</div><div class="hold" data-z="${i}"></div><div class="cap" id="scap${i}"></div></div>`).join('');
  document.getElementById('cores').innerHTML = [0, 1, 2].slice(0, d.threads).map(i =>
    `<div class="core" id="core${i}"><div class="st">코어 ${i + 1}</div><div class="cap" id="ccap${i}"></div></div>`).join('');
  document.querySelectorAll('.chip').forEach(c => c.remove());
  'ABC'.split('').forEach(n => {
    const c = document.createElement('div');
    c.className = 'chip c-queue'; c.textContent = n; chips[n] = c;
    document.querySelector('[data-z="queue"]').appendChild(c);
  });
  document.querySelectorAll('#tabs button').forEach(b => b.classList.toggle('on', b.dataset.k === key));
  document.getElementById('desc').textContent = d.desc;
}

function render(i, animate) {
  const d = MODES[key], s = d.steps[i];
  const first = {};
  if (animate) for (const n in chips) first[n] = chips[n].getBoundingClientRect();
  for (const n in chips) {
    const p = s.pos[n], c = chips[n];
    document.querySelector(`[data-z="${p}"]`).appendChild(c);
    let cls = 'c-queue';
    if (p === 'wait') cls = 'c-wait';
    else if (p === 'done') cls = 'c-done';
    else if (typeof p === 'number') cls = (s.hold === n) ? 'c-hold' : 'c-run';
    c.className = 'chip ' + cls;
  }
  if (animate) for (const n in chips) {
    const c = chips[n], last = c.getBoundingClientRect(), f = first[n];
    const dx = f.left - last.left, dy = f.top - last.top;
    if (!dx && !dy) continue;
    c.style.transition = 'none'; c.style.transform = `translate(${dx}px, ${dy}px)`;
    c.getBoundingClientRect();
    c.style.transition = 'transform .45s ease'; c.style.transform = '';
  }
  for (let t = 0; t < d.threads; t++) {
    const on = Object.keys(s.pos).find(n => s.pos[n] === t);
    const held = on && s.hold === on;
    document.getElementById('scap' + t).textContent = !on ? '비어 있음' : held ? `${on}가 붙잡고 기다림` : `${on} 실행 중`;
    const core = document.getElementById('core' + t);
    const busy = on && !held;
    core.className = 'core ' + (busy ? 'busy' : 'idle');
    document.getElementById('ccap' + t).textContent = busy ? '일하는 중' : held ? '쉼 (스레드가 잠듦)' : '쉼';
  }
  document.getElementById('clock').textContent = `시각 ${s.t}ms`;
  document.getElementById('msg').textContent = s.msg;
  const r = document.getElementById('result');
  if (i === d.steps.length - 1) { r.className = 'result done'; r.textContent = d.result; }
  else { r.className = 'result'; r.textContent = `${i + 1} / ${d.steps.length} 단계`; }
  idx = i;
}

function stop() { if (timer) { clearInterval(timer); timer = null; } document.getElementById('play').textContent = '▶ 재생'; }
function play() {
  stop();
  if (idx >= MODES[key].steps.length - 1) render(0, true);
  document.getElementById('play').textContent = '❚❚ 멈춤';
  timer = setInterval(() => {
    if (idx >= MODES[key].steps.length - 1) { stop(); document.getElementById('play').textContent = '↺ 다시'; return; }
    render(idx + 1, true);
  }, 1500);
}

document.getElementById('tabs').innerHTML = Object.entries(MODES).map(([k, v]) => `<button data-k="${k}">${v.label}</button>`).join('');
document.getElementById('tabs').addEventListener('click', e => {
  const k = e.target.dataset.k; if (!k) return;
  stop(); key = k; build(); render(0, false); play();
});
document.getElementById('play').onclick = () => { if (timer) stop(); else play(); };
document.getElementById('prev').onclick = () => { stop(); if (idx > 0) render(idx - 1, true); };
document.getElementById('next').onclick = () => { stop(); if (idx < MODES[key].steps.length - 1) render(idx + 1, true); };

// 블로그와 같은 도메인에서 iframe으로 열리면, iframe 높이를 내용에 맞춘다 (글의 height 값은 대비용)
function fitFrame() {
  try { const f = window.frameElement; if (f) f.style.height = Math.ceil(document.querySelector('.wrap').getBoundingClientRect().height) + 'px'; } catch (e) {}
}
new ResizeObserver(fitFrame).observe(document.querySelector('.wrap'));
build(); render(0, false); fitFrame();
</script>
</body>
</html>
</file>

<file path="assets/demo/concurrency-inference-simulator.html">
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Swift Concurrency: 격리 추론 & 상속 시뮬레이터 Pro</title>
    <style>
        :root {
            --bg-color: #f5f7fa;
            --card-bg: #ffffff;
            --text-color: #2c3e50;
            --border-color: #e2e8f0;
            --primary-color: #007aff;
            --dark-bg: #1e1e1e;
            --hl-class: rgba(0, 122, 255, 0.18);
            --hl-func: rgba(52, 199, 89, 0.18);
            --hl-inher: rgba(255, 149, 0, 0.22);
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            padding: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        h1 { font-size: 24px; text-align: center; margin-bottom: 5px; }
        .sub-title { text-align: center; color: #718096; margin-bottom: 25px; font-size: 14px; }
        
        .tabs { display: flex; gap: 10px; margin-bottom: 20px; justify-content: center; }
        .tab-btn {
            background: #e2e8f0;
            color: #4a5568;
            border: none;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .tab-btn.active { background: var(--primary-color); color: white; }

        .grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 25px; }
        @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
        
        .card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        }

        .code-window {
            background-color: var(--dark-bg);
            color: #d4d4d4;
            font-family: "SFMono-Regular", Consolas, Menlo, monospace;
            padding: 20px;
            border-radius: 10px;
            font-size: 13px;
            line-height: 1.7;
            position: relative;
            overflow-x: auto;
        }
        .code-line { display: block; border-radius: 4px; padding: 0 5px; transition: background 0.2s; }
        
        .hl-class-decl { background-color: var(--hl-class); color: #4fc3f7 !important; }
        .hl-func-decl { background-color: var(--hl-func); color: #81c784 !important; }
        .hl-inheritance-path { background-color: var(--hl-inher); color: #ffb74d !important; }

        .debugger-window { display: flex; flex-direction: column; height: 100%; }
        
        .header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .play-btn {
            background: #4a5568;
            color: white;
            border: none;
            padding: 6px 12px;
            font-size: 12px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.2s;
        }
        .play-btn:hover { background: #2d3748; }
        .play-btn.playing { background: #e53e3e; }

        .step-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; }
        .step-item {
            background: #f8f9fa;
            border: 1px solid #e2e8f0;
            border-left: 4px solid #cbd5e0;
            padding: 12px;
            border-radius: 6px;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .step-item:hover { transform: translateX(3px); background: #f1f3f5; }
        .step-item.active {
            border-left-color: var(--primary-color);
            background: #edf2f7;
            font-weight: bold;
        }

        .analysis-box {
            background: #1a202c;
            color: #e2e8f0;
            padding: 15px;
            border-radius: 8px;
            font-size: 13px;
            min-height: 110px;
            border-left: 4px solid var(--primary-color);
        }
        
        .keyword { color: #ff7b72; }
        .type { color: #79c0ff; }
        .comment { color: #8b949e; }
    </style>
</head>
<body>

    <h1>Swift Concurrency 격리 추론 vs 상속 검증기</h1>
    <div class="sub-title">컴파일 타임에 결정되는 정적 격리(Static Isolation)의 분석 경로를 시각적으로 체득한다.</div>

    <div class="tabs">
        <button class="tab-btn active" id="tab-infer">시나리오 1: 정적 격리 추론 (Inference)</button>
        <button class="tab-btn" id="tab-inherit">시나리오 2: 비동기 격리 상속 (Inheritance)</button>
    </div>

    <div class="grid">
        <div class="card">
            <h3 style="margin-top:0; font-size:15px; color:#4a5568;">💻 Xcode 가상 컴파일 분석 창</h3>
            <div class="code-window" id="code-area"></div>
        </div>

        <div class="card debugger-window">
            <div class="header-row">
                <h3 style="margin:0; font-size:15px; color:#4a5568;">⚙️ 컴파일러 정적 추론 단계</h3>
                <button class="play-btn" id="btn-play">▶ 자동 재생</button>
            </div>
            <div class="step-list" id="step-area"></div>
            
            <h3 style="font-size:14px; color:#4a5568; margin-bottom:8px;">🧐 컴파일러 분석 리포트</h3>
            <div class="analysis-box" id="analysis-text"></div>
        </div>
    </div>

    <script>
        const data = {
            infer: {
                code: [
                    `<span class="code-line" id="line1"><span class="keyword">@MainActor</span></span>`,
                    `<span class="code-line" id="line2"><span class="keyword">class</span> <span class="type">ProfileViewModel</span> {</span>`,
                    `<span class="code-line" id="line3">    <span class="keyword">var</span> name: <span class="type">String</span> = ""</span>`,
                    `<span class="code-line" id="line4"></span>`,
                    `<span class="code-line" id="line5">    <span class="comment">// 개발자가 별도의 격리 키워드를 명시하지 않은 상태</span></span>`,
                    `<span class="code-line" id="line6">    <span class="keyword">func</span> updateProfile(newName: <span class="type">String</span>) {</span>`,
                    `<span class="code-line" id="line7">        <span class="keyword">self</span>.name = newName</span>`,
                    `<span class="code-line" id="line8">    }</span>`,
                    `<span class="code-line" id="line9">}</span>`
                ],
                steps: [
                    { title: "1단계: @MainActor 속성 감지", lines: [1, 2], text: "컴파일러가 'ProfileViewModel' 클래스 선언 상단에 명시된 '@MainActor' 글로벌 액터 어노테이션을 파싱한다. 타입 전체가 메인 격리 영역으로 예약된다." },
                    { title: "2단계: 내부 멤버 분석", lines: [5, 6, 7, 8], text: "내부의 'updateProfile' 함수를 검사한다. 명시적인 'nonisolated' 키워드가 부재함을 확인한다." },
                    { title: "3단계: 정적 추론(Inference) 완료", lines: [6], text: "<b>[추론 결과]</b> 클래스 전체가 @MainActor에 격리되어 있으므로, 내부 함수인 'updateProfile' 역시 자동으로 메인 액터 컨텍스트에 포함된다고 정적 추론(Static Inference)한다. 런타임 검사 오버헤드는 없다." }
                ]
            },
            inherit: {
                code: [
                    `<span class="code-line" id="line1"><span class="keyword">@MainActor</span></span>`,
                    `<span class="code-line" id="line2"><span class="keyword">class</span> <span class="type">MyViewController</span> {</span>`,
                    `<span class="code-line" id="line3">    <span class="keyword">func</span> updateUI() { <span class="comment">/* 메인 스레드 전용 UI 코드 */</span> }</span>`,
                    `<span class="code-line" id="line4"></span>`,
                    `<span class="code-line" id="line5">    <span class="keyword">func</span> loadData() <span class="keyword">async</span> {</span>`,
                    `<span class="code-line" id="line6">        <span class="keyword">let</span> result = <span class="keyword">await</span> networkCall() <span class="comment">// 대기 및 일시중단점</span></span>`,
                    `<span class="code-line" id="line7">        </span>`,
                    `<span class="code-line" id="line8">        <span class="comment">// 중단점 해제 후 동기 함수 호출</span></span>`,
                    `<span class="code-line" id="line9">        <span class="keyword">self</span>.updateUI() </span>`,
                    `<span class="code-line" id="line10">    }</span>`,
                    `<span class="code-line" id="line11">}</span>`
                ],
                steps: [
                    { title: "1단계: 호출자 격리 상태 파악", lines: [5], text: "함수 'loadData()'는 정적 추론에 의해 @MainActor 소속으로 정의되어 실행을 시작한다." },
                    { title: "2단계: await 서스펜션 포인트 통과", lines: [6], text: "await 대기 지점에서 태스크가 일시 중단(Suspension)된다. 이때 비동기 처리를 위해 <b>물리적 스레드는 자유롭게 변경(Thread Hopping)될 수 있으나, 해당 태스크의 메인 격리 영역(Isolation Context) 자격은 복귀 전까지 차단된 채 시스템에 의해 안전하게 보존</b>된다." },
                    { title: "3단계: 격리 상속(Inheritance) 발동", lines: [6, 9], text: "<b>[상속 결과]</b> 비동기 작업 종료 후 태스크가 깨어날 때, 기존의 메인 액터 격리 자격을 그대로 <b>상속(Inheritance)</b>하여 복귀한다. 덕분에 스레드가 바뀐 상태였더라도 안전하게 메인 액터 위로 돌아오므로, 동기 함수 'updateUI()'를 안전하게 다이렉트 호출할 수 있다." }
                ]
            }
        };

        let currentScenario = 'infer';
        let currentStep = 0;
        let playInterval = null;

        function renderScenario(type) {
            stopAutoPlay();
            currentScenario = type;
            currentStep = 0;
            
            document.getElementById('code-area').innerHTML = data[type].code.join('');
            
            const stepArea = document.getElementById('step-area');
            stepArea.innerHTML = '';
            data[type].steps.forEach((step, idx) => {
                const item = document.createElement('div');
                item.className = 'step-item';
                item.innerText = step.title;
                item.onclick = () => { stopAutoPlay(); selectStep(idx); };
                stepArea.appendChild(item);
            });
            
            selectStep(0);
        }

        function selectStep(stepIdx) {
            currentStep = stepIdx;
            const lines = document.querySelectorAll('.code-line');
            lines.forEach(l => l.className = 'code-line');
            
            const steps = document.querySelectorAll('.step-item');
            steps.forEach(s => s.classList.remove('active'));
            
            if(steps[stepIdx]) steps[stepIdx].classList.add('active');
            const targetStep = data[currentScenario].steps[stepIdx];
            
            document.getElementById('analysis-text').innerHTML = targetStep.text;
            
            let hlClass = 'hl-class-decl';
            if (stepIdx === 1) hlClass = 'hl-func-decl';
            if (stepIdx === 2) hlClass = currentScenario === 'infer' ? 'hl-func-decl' : 'hl-inheritance-path';

            targetStep.lines.forEach(lineNum => {
                const lineEl = document.getElementById('line' + lineNum);
                if (lineEl) lineEl.classList.add(hlClass);
            });
        }

        // 자동 재생 로직
        function toggleAutoPlay() {
            const btn = document.getElementById('btn-play');
            if (playInterval) {
                stopAutoPlay();
            } else {
                btn.innerText = "■ 정지";
                btn.classList.add('playing');
                playInterval = setInterval(() => {
                    currentStep = (currentStep + 1) % data[currentScenario].steps.length;
                    selectStep(currentStep);
                }, 1600);
            }
        }

        function stopAutoPlay() {
            const btn = document.getElementById('btn-play');
            if (playInterval) {
                clearInterval(playInterval);
                playInterval = null;
            }
            btn.innerText = "▶ 자동 재생";
            btn.classList.remove('playing');
        }

        document.getElementById('btn-play').addEventListener('click', toggleAutoPlay);

        document.getElementById('tab-infer').addEventListener('click', (e) => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            e.target.classList.add('active');
            renderScenario('infer');
        });

        document.getElementById('tab-inherit').addEventListener('click', (e) => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            e.target.classList.add('active');
            renderScenario('inherit');
        });

        renderScenario('infer');
    </script>

</body>
</html>
</file>

<file path="assets/demo/crown_step_simulator.html">
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Crown Step Simulator</title>
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#ffffff; --panel:#f7f8fa; --line:#e3e6ea; --ink:#16181d; --dim:#6b7280;
    --faint:#9aa1ab; --bad:#d0392b; --bad-bg:#fbeae8; --ok:#0d9276; --ok-bg:#e2f4ef;
    --mark:#2563eb; --mark-bg:#e8effc;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:#09090b; --panel:#141417; --line:#27272a; --ink:#f4f4f5; --dim:#a1a1aa;
      --faint:#71717a; --bad:#f87171; --bad-bg:#331416; --ok:#34d399; --ok-bg:#0d2b23;
      --mark:#60a5fa; --mark-bg:#14203a;
    }
  }
  * { box-sizing:border-box; }
  body { margin:0; padding:16px; background:var(--bg); color:var(--ink);
    font-family:'Inter',-apple-system,'Apple SD Gothic Neo',sans-serif;
    user-select:none; -webkit-user-select:none; }
  h1 { font-size:15px; font-weight:700; margin:0 0 5px; }
  .lead { font-size:12.5px; line-height:1.6; color:var(--dim); margin:0 0 14px; max-width:66ch; }
  .lead code { font-family:'Fira Code',monospace; font-size:11.5px; background:var(--panel); padding:1px 5px; border-radius:4px; }

  .bar { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:12px; }
  .bar > span { font-family:'Fira Code',monospace; font-size:10px; letter-spacing:.04em;
    color:var(--faint); text-transform:uppercase; margin-right:2px; }
  .seg { display:flex; border:1px solid var(--line); border-radius:7px; overflow:hidden; }
  .seg button { border:none; background:var(--bg); color:var(--dim); cursor:pointer;
    font-family:'Fira Code',monospace; font-size:11.5px; font-weight:500; padding:9px 13px;
    border-right:1px solid var(--line); transition:background .13s,color .13s; }
  .seg button:last-child { border-right:none; }
  .seg button[aria-pressed="true"] { background:var(--ok); color:var(--bg); font-weight:600; }
  .seg button.danger[aria-pressed="true"] { background:var(--bad); }
  .btn { border:1px solid var(--line); background:var(--panel); color:var(--ink); cursor:pointer;
    font-family:'Fira Code',monospace; font-size:11.5px; padding:9px 13px; border-radius:7px; }
  .btn:active { background:var(--line); }
  .sp { flex:1 1 6px; }

  .stage { display:grid; grid-template-columns:auto 1fr; gap:14px; align-items:center;
    border:1px solid var(--line); border-radius:10px; background:var(--panel); padding:14px; }
  @media (max-width:560px){ .stage{grid-template-columns:1fr; justify-items:center; gap:10px;} }

  .crown { display:flex; flex-direction:column; align-items:center; gap:7px; }
  .crown .dial { width:74px; height:74px; border-radius:50%; border:2px solid var(--line);
    display:flex; align-items:center; justify-content:center; background:var(--bg); position:relative; }
  .crown .dial i { position:absolute; width:3px; height:13px; border-radius:2px; background:var(--mark);
    top:5px; left:50%; margin-left:-1.5px; transform-origin:50% 32px; transition:transform .18s ease; }
  .crown .dial span { font-family:'Fira Code',monospace; font-size:9px; color:var(--faint); }
  .crown .keys { display:flex; gap:6px; }
  .crown .keys button { width:38px; }

  .read { text-align:center; }
  .read .big { font-family:'Fira Code',monospace; font-size:34px; font-weight:600; letter-spacing:-.01em; font-variant-numeric:tabular-nums; }
  .read .sub { font-family:'Fira Code',monospace; font-size:11px; color:var(--faint); margin-top:2px; }

  .strip { display:flex; gap:5px; flex-wrap:wrap; margin-top:12px; }
  .chip { font-family:'Fira Code',monospace; font-size:11px; padding:5px 8px; border-radius:6px;
    border:1px solid var(--line); background:var(--panel); color:var(--dim); font-variant-numeric:tabular-nums; }
  .chip.on { background:var(--mark); border-color:var(--mark); color:var(--bg); font-weight:600; }
  .chip.round { border-color:var(--ok); color:var(--ok); }

  .presets { display:flex; gap:6px; flex-wrap:wrap; margin-top:12px; align-items:center; }
  .presets > span { font-family:'Fira Code',monospace; font-size:10px; letter-spacing:.04em; color:var(--faint); text-transform:uppercase; }

  .note { margin-top:12px; font-size:12.5px; line-height:1.65; color:var(--dim); border-left:2px solid var(--line); padding-left:12px; }
  .note b { color:var(--ink); font-weight:600; }
  .note.alarm { border-left-color:var(--bad); }
  .note.fine { border-left-color:var(--ok); }
</style>
</head>
<body>

<h1>크라운 한 칸이 만드는 눈금</h1>
<p class="lead">디지털 크라운으로 목표 거리를 고르는 화면이다. 처음엔 최소값 100m에서 0.5km씩 더하게 짰는데, 시작점 자체가 0.5의 배수가 아니라서 <b>그 뒤의 모든 값이 통째로 밀렸다.</b></p>

<div class="bar">
  <span>눈금 방식</span>
  <div class="seg" id="seg">
    <button type="button" class="danger" data-mode="add" aria-pressed="true">0.1에서 0.5씩 더하기</button>
    <button type="button" data-mode="index" aria-pressed="false">정해둔 목록에서 고르기</button>
  </div>
  <span class="sp"></span>
  <button type="button" class="btn" id="reset">처음으로</button>
</div>

<div class="stage">
  <div class="crown">
    <div class="dial"><i id="tick"></i><span>CROWN</span></div>
    <div class="keys">
      <button type="button" class="btn" id="down">−</button>
      <button type="button" class="btn" id="up">+</button>
    </div>
  </div>
  <div class="read">
    <div class="big" id="v-dist">--</div>
    <div class="sub" id="v-sub">--</div>
  </div>
</div>

<div class="presets" style="margin-top:12px"><span id="strip-cap">크라운 눈금</span></div>
<div class="strip" id="strip"></div>

<div class="presets">
  <span>프리셋</span>
  <button type="button" class="btn" data-preset="3">3K</button>
  <button type="button" class="btn" data-preset="5">5K</button>
  <button type="button" class="btn" data-preset="10">10K</button>
  <button type="button" class="btn" data-preset="21.1">HALF</button>
</div>

<div class="note" id="note">+ 를 눌러 크라운을 돌려보자.</div>

<script>
(function () {
  "use strict";

  var STEPS = (function () {
    var s = [0.1], v = 0.5;
    while (v < 21.1) { s.push(v); v += 0.5; }
    s.push(21.1);
    v = 21.5;
    while (v < 42.2) { s.push(v); v += 0.5; }
    s.push(42.2);
    return s;
  })();

  var mode = "add";
  var crown = 0.1;      // 수정 전: 크라운이 들고 있는 값
  var dist = 0.1;       // 수정 전: 화면에 보이는 거리 (프리셋은 이것만 바꿨다)
  var idx = 0;          // 수정 후: 크라운 값이 목록의 자리 번호
  var turns = 0;        // 프리셋을 누른 뒤 크라운을 돌렸는지 보기 위한 값
  var jumped = false;

  function distance() { return mode === "add" ? dist : STEPS[idx]; }
  function fmt(km) { return km < 1 ? Math.round(km * 1000) + " m" : (Math.round(km * 10) / 10).toFixed(1) + " km"; }
  function isRound(km) { return Math.abs(km * 2 - Math.round(km * 2)) < 1e-9; }

  function neighbours() {
    var out = [];
    if (mode === "add") {
      for (var k = -3; k <= 3; k++) {
        var v = Math.round((crown + k * 0.5) * 10) / 10;
        if (v >= 0.1 && v <= 42.2) out.push({ v: v, on: k === 0 });
      }
    } else {
      for (var j = Math.max(0, idx - 3); j <= Math.min(STEPS.length - 1, idx + 3); j++) {
        out.push({ v: STEPS[j], on: j === idx });
      }
    }
    return out;
  }

  function render() {
    document.getElementById("v-dist").textContent = fmt(distance());
    document.getElementById("v-sub").textContent = mode === "add"
      ? "크라운이 들고 있는 값 " + crown.toFixed(1)
      : "목록의 " + (idx + 1) + "번째 값";
    document.getElementById("tick").style.transform = "rotate(" + (turns * 32 % 360) + "deg)";

    document.getElementById("strip-cap").textContent = mode === "add"
      ? "크라운이 오갈 수 있는 값들" : "목록에 정해둔 값들";
    document.getElementById("strip").innerHTML = neighbours().map(function (n) {
      return '<span class="chip' + (n.on ? " on" : (isRound(n.v) ? " round" : "")) + '">' + fmt(n.v) + '</span>';
    }).join("");

    var note = document.getElementById("note");
    if (jumped) {
      note.className = "note alarm";
      note.innerHTML = "프리셋을 누르면 거리만 바뀌고 <b>크라운은 원래 자리에 그대로 있다.</b> 그래서 한 칸만 돌려도 방금 고른 값과 상관없는 곳으로 튄다.";
      return;
    }
    if (mode === "add") {
      note.className = "note alarm";
      note.innerHTML = "0.1에서 0.5씩 더하니 <b>100m, 600m, 1.1km, 1.6km…</b>가 된다. 5km나 10km 같은 값에는 아무리 돌려도 닿을 수 없다.";
    } else {
      note.className = "note fine";
      note.innerHTML = "크라운은 <b>목록의 자리 번호만</b> 오간다. 100m는 맨 앞에 예외로 하나 두고 그 뒤는 0.5km 단위로 채웠기 때문에, 100m 다음 칸이 바로 500m이고 그 뒤로 1.0km, 1.5km로 이어진다. 하프(21.1km)와 풀(42.2km)만 격자 사이에 따로 끼워 넣었다.";
    }
  }

  function turn(dir) {
    jumped = false; turns += dir;
    if (mode === "add") {
      crown = Math.min(42.2, Math.max(0.1, Math.round((crown + dir * 0.5) * 10) / 10));
      dist = crown;   // onChange(of: crownValue) 가 거리를 크라운 값으로 덮어쓴다
    } else {
      idx = Math.min(STEPS.length - 1, Math.max(0, idx + dir));
    }
    render();
  }

  document.getElementById("up").addEventListener("click", function(){ turn(1); });
  document.getElementById("down").addEventListener("click", function(){ turn(-1); });
  document.getElementById("reset").addEventListener("click", function(){
    crown = 0.1; dist = 0.1; idx = 0; turns = 0; jumped = false; render();
  });
  document.querySelectorAll("[data-preset]").forEach(function (b) {
    b.addEventListener("click", function () {
      var p = parseFloat(b.dataset.preset);
      if (mode === "add") {
        dist = p;             // 거리만 세팅하고 크라운 값은 손대지 않던 예전 방식
        jumped = true;
      } else {
        idx = STEPS.indexOf(p);
        jumped = false;
      }
      render();
    });
  });
  document.querySelectorAll("#seg button").forEach(function (b) {
    b.addEventListener("click", function () {
      mode = b.dataset.mode; crown = 0.1; dist = 0.1; idx = 0; turns = 0; jumped = false;
      document.querySelectorAll("#seg button").forEach(function (x) { x.setAttribute("aria-pressed", String(x === b)); });
      render();
    });
  });
  render();
})();
</script>
</body>
</html>
</file>

