    blocks: [
      [1, 0, 204, 'busy() 1번째', 'actor'],
      [1, 204, 408, 'busy() 2번째', 'actor'],
    ],
    msgs: [
      [0, '첫 번째 busy()가 actor에 들어간다. 두 번째는 차례를 기다린다.'],
      [204, '첫 번째가 끝나야 두 번째가 들어간다. actor는 한 번에 하나씩이다.'],
      [408, '둘 다 끝났다.'],
    ],
    result: '408ms. actor는 한 번에 하나씩이라 두 배가 걸렸다. detached와 달리 안쪽을 지켜주는 영역이다.',
  },
};

const lanesEl = document.getElementById('lanes');
let cur = null, raf = null;

function draw(key) {
  const d = TABS[key]; cur = { key, d };
  lanesEl.innerHTML = d.lanes.map((n, i) =>
    `<div class="lane ${i === d.mainLane && n === 'MainActor' ? 'mainactor' : ''}"><div class="name">${n}</div><div class="track" data-lane="${i}"></div></div>`
  ).join('') + '<div class="head" id="head"></div>';
  const tracks = lanesEl.querySelectorAll('.track');
  d.blocks.forEach(([lane, a, b, lab, kind, short], i) => {
    const left = a / d.max * 100, width = (b - a) / d.max * 100;
    tracks[lane].insertAdjacentHTML('beforeend',
      `<div class="blk k-${kind}" data-i="${i}" style="left:${left}%;width:${width}%"><div class="fill"></div><div class="lab"><span class="f">${lab}</span><span class="s">${short || lab}</span></div></div>`);
  });
  document.querySelectorAll('#tabs button').forEach(b => b.classList.toggle('on', b.dataset.k === key));
  document.getElementById('desc').textContent = d.desc;
}

function render(p) { // p: 지금 시각(ms). null이면 전체
  const d = cur.d, all = p === null;
  lanesEl.querySelectorAll('.blk').forEach(el => {
    const [, a, b] = d.blocks[+el.dataset.i];
    const k = all ? 1 : Math.max(0, Math.min(1, (p - a) / (b - a)));
    el.style.opacity = all || p >= a ? 1 : 0;
    el.querySelector('.fill').style.width = (k * 100) + '%';
  });
  const head = document.getElementById('head');
  head.style.display = all ? 'none' : 'block';
  if (!all) {
    const nameW = lanesEl.querySelector('.name').getBoundingClientRect().width;
    head.style.left = `calc(${nameW}px + (100% - ${nameW}px) * ${Math.min(p, d.max) / d.max})`;
  }
  const m = document.getElementById('msg');
  if (all) m.textContent = '▶ 재생을 누르면 시간 순서대로 따라간다. 빨간 선이 지금 시각이다.';
  else { const cands = d.msgs.filter(x => x[0] <= p); m.textContent = cands.length ? cands[cands.length - 1][1] : ''; }
  const r = document.getElementById('result');
  const end = Math.max(...d.blocks.map(x => x[2]));
  if (all || p >= end) { r.className = 'result done'; r.textContent = d.result; }
  else { r.className = 'result'; r.textContent = ''; }
}

function play() {
  if (raf) cancelAnimationFrame(raf);
  const d = cur.d, dur = 3200, start = performance.now();
  const end = Math.max(...d.blocks.map(x => x[2]));
  document.getElementById('play').textContent = '↺ 다시';
  const tick = now => {
    const p = (now - start) / dur * d.max;
    render(Math.min(p, d.max));
    raf = p < d.max ? requestAnimationFrame(tick) : null;
  };
  raf = requestAnimationFrame(tick);
}

document.getElementById('tabs').innerHTML = Object.entries(TABS).map(([k, v]) => `<button data-k="${k}">${v.label}</button>`).join('');
document.getElementById('tabs').addEventListener('click', e => { const k = e.target.dataset.k; if (!k) return; draw(k); play(); });
document.getElementById('play').onclick = play;

// 블로그와 같은 도메인에서 iframe으로 열리면, iframe 높이를 내용에 맞춘다 (글의 height 값은 대비용)
function fitFrame() {
  try { const f = window.frameElement; if (f) f.style.height = Math.ceil(document.querySelector('.wrap').getBoundingClientRect().height) + 'px'; } catch (e) {}
}
new ResizeObserver(fitFrame).observe(document.querySelector('.wrap'));
draw('task'); render(null); fitFrame();
</script>
</body>
</html>
