<body>

<h1>못 믿을 속도값이 들어왔을 때</h1>
<p class="lead">오버스피드에 반응해 속도를 줄이는 구간은 GPS도 속도를 가늠하기 애매해서 <code>speedAccuracy</code>가 음수로 찍히는 일이 흔하다. 이때 정지 판단은 건너뛰는데 페이스용 속도값은 그대로 갱신되고 있었다.</p>

<div class="bar">
  <div class="grp">
    <span>코드 버전</span>
    <div class="seg" id="seg-mode">
      <button type="button" class="danger" data-mode="bug" aria-pressed="true">수정 전 (1.3)</button>
      <button type="button" data-mode="fix" aria-pressed="false">수정 후 (1.3.1)</button>
    </div>
  </div>
  <span class="spacer"></span>
  <button type="button" class="btn" id="reset">처음으로</button>
  <button type="button" class="btn" id="step">샘플 하나 더</button>
  <button type="button" class="btn primary" id="play">재생</button>
</div>

<div class="row">
  <div class="cell"><div class="k">GPS 신뢰도</div><div class="v" id="v-acc">--</div></div>
  <div class="cell"><div class="k">실제 속도</div><div class="v" id="v-raw">--</div></div>
  <div class="cell"><div class="k">계산용 속도</div><div class="v" id="v-sm">--</div></div>
  <div class="cell"><div class="k">화면 페이스</div><div class="v" id="v-pace">--</div></div>
  <div class="cell"><div class="k">목표와 차이</div><div class="v" id="v-dev">--</div></div>
</div>

<div class="chart">
  <div id="plot"></div>
  <div class="legend">
    <span><i style="background:var(--bad)"></i>수정 전</span>
    <span><i style="background:var(--ok)"></i>수정 후</span>
    <span><i style="background:var(--faint);opacity:.6"></i>목표 5'45"</span>
    <span>회색 구간 = 신뢰도 음수</span>
  </div>
</div>

<div class="note" id="note">재생을 누르면 GPS 샘플이 1초에 하나씩 들어온다.</div>

<script>
(function () {
  "use strict";
  var TARGET = 5.75, A = 0.15, CAP = 30;

  // [속도(m/s), 신뢰도] · 앞에서 빠르게 달리다 감속하는 동안 신뢰도가 음수로 떨어진다
  var S = [
    [4.20,1.5],[4.25,1.5],[4.18,1.5],[4.22,1.5],
    [3.40,-1],[2.60,-1],[1.90,-1],[1.40,-1],[1.00,-1],[0.70,-1],[0.45,-1],[0.28,-1],
    [0.15,-1],[0.08,-1],[0.03,-1],[0.00,-1],[0.00,-1],[0.00,-1],[0.00,-1],[0.00,-1],
    [3.30,1.5],[3.45,1.5],[3.38,1.5],[3.42,1.5],[3.40,1.5],[3.44,1.5]
  ];

  function simulate(mode) {
    var sf=0, ss=0, out=[];
    S.forEach(function (s) {
      var cs = Math.max(s[0],0), open = s[1] >= 0;
      function smooth(){
        if (sf===0 && cs>0){ sf=cs; ss=cs; }
        sf=(1-A)*sf+A*cs; ss=(1-A)*ss+A*sf;
      }
      if (open) smooth();            // 게이트 안 (두 버전 공통)
      else if (mode==="bug") smooth(); // 수정 전에는 게이트 밖에서도 갱신됐다
      var pace = ss>0 ? 1000/(ss*60) : Infinity;
      out.push({ acc:s[1], raw:cs, ss:ss, pace:pace, open:open });
    });
    return out;
  }

  var BUG = simulate("bug"), FIX = simulate("fix");
  var mode="bug", i=-1, timer=null;

  function fmtPace(p){
    if(!isFinite(p) || p>CAP) return "∞";
    var m=Math.floor(p), s=Math.round((p-m)*60);
    if(s===60){m++;s=0;}
    return m+"'"+(s<10?"0"+s:s)+'"';
  }
  function fmtDev(p){
    if(!isFinite(p) || p>CAP) return "∞";
    var d = Math.round((p-TARGET)*60);
    if (d === 0) return "0초";
    return (d>0 ? "+" : "") + d + "초";
  }

  function draw(){
    var W=880,H=180,PL=46,PR=14,PT=16,PB=30, n=S.length;
    var lo=3.5, hi=CAP;
    var X=function(k){return PL+k*(W-PL-PR)/(n-1);};
    var Y=function(v){
      var c=Math.max(lo,Math.min(isFinite(v)?v:hi,hi));
      // 위쪽이 느린 페이스. 큰 값이 위로 가도록 뒤집는다
      return PT+(H-PT-PB)*(1-(Math.log(c)-Math.log(lo))/(Math.log(hi)-Math.log(lo)));
    };
    var s='<svg viewBox="0 0 '+W+' '+H+'" role="img" aria-label="페이스가 발산하는 과정">';
    // 신뢰도 음수 구간
    var from=null;
    S.forEach(function(p,k){
      if(p[1]<0 && from===null) from=k;
      if((p[1]>=0||k===n-1) && from!==null){
        s+='<rect x="'+X(from).toFixed(1)+'" y="'+PT+'" width="'+(X(k)-X(from)).toFixed(1)+'" height="'+(H-PT-PB)+'" fill="var(--faint)" opacity="0.13"/>';
        from=null;
      }
    });
    [4,6,10,20,30].forEach(function(v){
      s+='<line x1="'+PL+'" y1="'+Y(v).toFixed(1)+'" x2="'+(W-PR)+'" y2="'+Y(v).toFixed(1)+'" stroke="var(--grid)"/>';
      s+='<text x="'+(PL-7)+'" y="'+(Y(v)+3.5).toFixed(1)+'" text-anchor="end" font-size="9.5" font-family="Fira Code,monospace" fill="var(--faint)">'+(v>=CAP?"∞":v+"'")+'</text>';
    });
    s+='<line x1="'+PL+'" y1="'+Y(TARGET).toFixed(1)+'" x2="'+(W-PR)+'" y2="'+Y(TARGET).toFixed(1)+'" stroke="var(--faint)" stroke-width="1" stroke-dasharray="5 4" opacity="0.7"/>';

    function path(arr,upto){
      var d="";
      for(var k=0;k<=upto;k++) d+=(k?"L":"M")+X(k).toFixed(1)+" "+Y(arr[k].pace).toFixed(1);
      return d;
    }
    if(i>=0){
      var other = mode==="bug" ? FIX : BUG;
      var oc = mode==="bug" ? "var(--ok)" : "var(--bad)";
      var mc = mode==="bug" ? "var(--bad)" : "var(--ok)";
      s+='<path d="'+path(other,i)+'" fill="none" stroke="'+oc+'" stroke-width="1.4" opacity="0.4" stroke-dasharray="3 3"/>';
      s+='<path d="'+path(mode==="bug"?BUG:FIX,i)+'" fill="none" stroke="'+mc+'" stroke-width="2.2"/>';
      var cur=(mode==="bug"?BUG:FIX)[i];
      s+='<circle cx="'+X(i).toFixed(1)+'" cy="'+Y(cur.pace).toFixed(1)+'" r="4" fill="'+mc+'"/>';
    }
    s+='<text x="'+PL+'" y="'+(H-8)+'" font-size="9.5" font-family="Fira Code,monospace" fill="var(--faint)">0초</text>';
    s+='<text x="'+(W-PR)+'" y="'+(H-8)+'" text-anchor="end" font-size="9.5" font-family="Fira Code,monospace" fill="var(--faint)">'+(n-1)+'초</text>';
    s+='</svg>';
    document.getElementById("plot").innerHTML=s;
  }

  function render(){
    var arr = mode==="bug"?BUG:FIX;
    var f = i>=0 ? arr[i] : null;
    var set=function(id,v,cls){
      var e=document.getElementById(id); e.textContent=v;
      e.parentElement.className="cell"+(cls?" "+cls:"");
    };
    if(!f){
      ["v-acc","v-raw","v-sm","v-pace","v-dev"].forEach(function(id){ set(id,"--"); });
    } else {
      set("v-acc", f.open? f.acc.toFixed(1) : "음수", f.open?"":"alarm");
      set("v-raw", f.raw.toFixed(2)+" m/s");
      var frozen = !f.open && mode==="fix";
      set("v-sm", f.ss.toFixed(3)+" m/s", frozen?"good":(f.ss<0.5?"alarm":""));
      var big = !isFinite(f.pace)||f.pace>CAP;
      set("v-pace", fmtPace(f.pace), big?"alarm":"");
      set("v-dev", fmtDev(f.pace), big||f.pace-TARGET>5?"alarm":"");
    }
    draw();

    var note=document.getElementById("note");
    if(!f){ note.className="note"; note.textContent="재생을 누르면 GPS 샘플이 1초에 하나씩 들어온다."; return; }
    if(f.open && i<4){
      note.className="note"; note.innerHTML="신뢰할 수 있는 값이라 정상 처리된다. 목표보다 빠르게 달리는 중이다.";
    } else if(!f.open && mode==="bug"){
      note.className="note alarm";
      note.innerHTML="신뢰도가 음수라 <b>정지 판단은 건너뛴다.</b> 그런데 계산용 속도는 게이트 밖에 있어서 <b>이 못 믿을 값이 그대로 반영</b>됐다. 멈췄다고 확정된 게 아니니 페이스는 계속 새로 계산되고, 나누는 값이 0에 가까워질수록 결과가 커진다.";
    } else if(!f.open){
      note.className="note fine";
      note.innerHTML="신뢰도가 음수면 <b>정지 판단도 페이스 계산도 둘 다 건너뛴다.</b> 계산용 속도가 "+f.ss.toFixed(3)+"에서 그대로 멈춰 있어 페이스도 흔들리지 않는다.";
    } else if(mode==="bug"){
      note.className="note alarm";
      note.innerHTML="다시 제대로 뛰기 시작했는데도 <b>오염된 값이 천천히 회복되느라 페이스가 아직 돌아오지 않았다.</b> 화면에는 계속 SINK RATE가 떠 있다.";
    } else {
      note.className="note fine";
      note.innerHTML="신뢰도가 돌아오자 멈춰 있던 값에서 자연스럽게 이어진다.";
    }
  }

  function stop(){ if(timer){clearInterval(timer);timer=null;} document.getElementById("play").textContent="재생"; }
  function step(){ if(i>=S.length-1){stop();return;} i++; render(); }
  document.getElementById("step").addEventListener("click",function(){stop();step();});
  document.getElementById("reset").addEventListener("click",function(){stop();i=-1;render();});
  document.getElementById("play").addEventListener("click",function(){
    if(timer){stop();return;}
    if(i>=S.length-1) i=-1;
    this.textContent="일시정지"; step(); timer=setInterval(step,620);
  });
  document.querySelectorAll("#seg-mode button").forEach(function(b){
    b.addEventListener("click",function(){
      mode=b.dataset.mode;
      document.querySelectorAll("#seg-mode button").forEach(function(x){x.setAttribute("aria-pressed",String(x===b));});
      render();
    });
  });

  render();
})();
</script>
</body>
</html>
</file>

<file path="assets/demo/split_announce_channel_simulator.html">
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Split Announce Channel Simulator</title>
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#ffffff; --panel:#f7f8fa; --line:#e3e6ea; --ink:#16181d; --dim:#6b7280;
    --faint:#9aa1ab; --bad:#d0392b; --bad-bg:#fbeae8; --ok:#0d9276; --ok-bg:#e2f4ef;
    --mark:#2563eb; --mark-bg:#e8effc;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:#09090b; --panel:#141417; --line:#27272a; --ink:#f4f4f5; --dim:#a1a1aa;
      --faint:#71717a; --bad:#f87171; --bad-bg:#331416; --ok:#34d399; --ok-bg:#0d2b23;
      --mark:#60a5fa; --mark-bg:#14203a;
    }
  }
  * { box-sizing:border-box; }
  body { margin:0; padding:16px; background:var(--bg); color:var(--ink);
    font-family:'Inter',-apple-system,'Apple SD Gothic Neo',sans-serif;
    user-select:none; -webkit-user-select:none; }
  h1 { font-size:15px; font-weight:700; margin:0 0 5px; }
  .lead { font-size:12.5px; line-height:1.6; color:var(--dim); margin:0 0 14px; max-width:66ch; }
  .lead code { font-family:'Fira Code',monospace; font-size:11.5px; background:var(--panel); padding:1px 5px; border-radius:4px; }

  .bar { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:14px; }
  .bar > span { font-family:'Fira Code',monospace; font-size:10px; letter-spacing:.04em;
    color:var(--faint); text-transform:uppercase; margin-right:2px; }
  .seg { display:flex; border:1px solid var(--line); border-radius:7px; overflow:hidden; }
  .seg button { border:none; background:var(--bg); color:var(--dim); cursor:pointer;
    font-family:'Fira Code',monospace; font-size:11.5px; font-weight:500; padding:9px 13px;
    border-right:1px solid var(--line); transition:background .13s,color .13s; }
  .seg button:last-child { border-right:none; }
  .seg button[aria-pressed="true"] { background:var(--ok); color:var(--bg); font-weight:600; }
  .seg button.danger[aria-pressed="true"] { background:var(--bad); }
  .btn { border:1px solid var(--line); background:var(--panel); color:var(--ink); cursor:pointer;
    font-family:'Fira Code',monospace; font-size:11.5px; padding:9px 13px; border-radius:7px; }
  .btn.primary { background:var(--ok); border-color:var(--ok); color:var(--bg); font-weight:600; }
  .sp { flex:1 1 6px; }

  .row { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; margin-bottom:12px; }
  .cell { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:9px 11px; min-width:0; }
  .cell .k { font-family:'Fira Code',monospace; font-size:8.5px; letter-spacing:.04em; text-transform:uppercase; color:var(--faint); }
  .cell .v { font-family:'Fira Code',monospace; font-size:16px; font-weight:600; margin-top:4px; font-variant-numeric:tabular-nums; }
  .cell.alarm { background:var(--bad-bg); border-color:var(--bad); }
  .cell.alarm .v { color:var(--bad); }
  @media (max-width:520px){ .row{grid-template-columns:repeat(3,1fr);} .cell .v{font-size:14px;} }

  .cols { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  @media (max-width:600px){ .cols{grid-template-columns:1fr;} }
  .box { border:1px solid var(--line); border-radius:9px; background:var(--panel); padding:11px 12px; }
  .box h2 { font-family:'Fira Code',monospace; font-size:10px; letter-spacing:.04em; text-transform:uppercase;
    color:var(--faint); margin:0 0 9px; font-weight:500; }
  .list { display:flex; flex-direction:column; gap:5px; min-height:104px; }
  .item { font-family:'Fira Code',monospace; font-size:11.5px; padding:5px 9px; border-radius:6px;
    background:var(--bg); border:1px solid var(--line); display:flex; gap:8px; align-items:baseline; }
  .item .n { font-weight:600; color:var(--mark); min-width:20px; }
  .item .t { color:var(--dim); }
  .item.say { background:var(--mark-bg); border-color:transparent; }
  .item.bogus { background:var(--bad-bg); border-color:var(--bad); }
  .item.bogus .n { color:var(--bad); }
  .empty { font-size:11.5px; color:var(--faint); font-family:'Fira Code',monospace; padding:5px 2px; }

  .note { margin-top:12px; font-size:12.5px; line-height:1.65; color:var(--dim); border-left:2px solid var(--line); padding-left:12px; }
  .note b { color:var(--ink); font-weight:600; }
  .note.alarm { border-left-color:var(--bad); }
  .note.fine { border-left-color:var(--ok); }
</style>
</head>
<body>

<h1>안내 방송을 어느 통로로 내보낼 것인가</h1>
<p class="lead">1km를 채울 때마다 그 구간 기록을 읽어줘야 한다. 이미 스플릿을 꺼내는 함수(<code>allSplits()</code>)가 있으니 그걸 계속 불러서 새 스플릿이 생겼는지 확인하면 될 것 같지만, 이 함수는 <b>부를 때마다 남은 자투리 구간을 스플릿으로 확정해버린다.</b></p>

<div class="bar">
  <span>안내 통로</span>
  <div class="seg" id="seg">
    <button type="button" class="danger" data-mode="reuse" aria-pressed="true">allSplits() 계속 확인</button>
    <button type="button" data-mode="stream" aria-pressed="false">알림용 통로 따로</button>
  </div>
  <span class="sp"></span>
  <button type="button" class="btn" id="reset">처음으로</button>
  <button type="button" class="btn" id="step">위치 하나 더</button>
  <button type="button" class="btn primary" id="play">재생</button>
</div>

<div class="row">
  <div class="cell"><div class="k">누적 거리</div><div class="v" id="v-dist">--</div></div>
  <div class="cell"><div class="k">저장될 스플릿</div><div class="v" id="v-saved">--</div></div>
  <div class="cell"><div class="k">잘못된 안내</div><div class="v" id="v-wrong">--</div></div>
</div>

<div class="cols">
  <div class="box">
    <h2>저장될 스플릿 목록</h2>
    <div class="list" id="saved"></div>
  </div>
  <div class="box">
    <h2>귀에 들리는 안내</h2>
    <div class="list" id="said"></div>
  </div>
</div>
<div class="note" id="note">재생을 누르면 위치가 하나씩 들어온다.</div>

<script>
(function () {
  "use strict";
  var MOVES = [280, 300, 260, 320, 290, 310, 240, 300, 280, 320, 260, 290, 310, 270, 300];
  var UNIT = 1000, TAIL_MIN = 100;

  var mode = "reuse", i = -1, timer = null;

  // allSplits() 를 흉내낸다. 남은 자투리가 100m 이상이면 그걸 스플릿으로 확정하고 번호를 하나 쓴다.
  function simulate(upto) {
    var dist = 0, startAt = 0, idx = 0;
    var saved = [], said = [], wrong = 0;

    for (var k = 0; k <= upto; k++) {
      dist += MOVES[k];

      // 1km 경계를 넘겼으면 정상 스플릿을 확정한다 (두 방식 공통)
      while (dist - startAt >= UNIT) {
        idx++;
        saved.push({ n: idx, label: "1.00km 구간", bogus: false });
        if (mode === "stream") said.push({ n: idx, text: idx + "킬로미터, 페이스 5분 42초", bogus: false });
        startAt += UNIT;
      }

      if (mode === "reuse") {
        // 새 스플릿이 생겼는지 확인하려고 매 업데이트마다 allSplits() 를 부른다
        var tail = dist - startAt;
        if (tail >= TAIL_MIN) {
          idx++;
          saved.push({ n: idx, label: (tail / 1000).toFixed(2) + "km 자투리", bogus: true });
          said.push({ n: idx, text: idx + "킬로미터, 페이스 측정 불가", bogus: true });
          wrong++;
          startAt = dist;         // 자투리를 확정했으니 다음 구간은 여기서 다시 시작한다
        }
      }
    }
    return { dist: dist, saved: saved, said: said, wrong: wrong, idx: idx };
  }

  function fill(el, arr, kind) {
    if (!arr.length) { el.innerHTML = '<div class="empty">아직 없음</div>'; return; }
    var view = arr.slice(-4);
    el.innerHTML = view.map(function (x) {
      var cls = "item" + (x.bogus ? " bogus" : (kind === "say" ? " say" : ""));
      var body = kind === "say" ? x.text : x.label;
      return '<div class="' + cls + '"><span class="n">' + x.n + '</span><span class="t">' + body + '</span></div>';
    }).join("");
    if (arr.length > 4) el.insertAdjacentHTML("afterbegin", '<div class="empty">앞의 ' + (arr.length - 4) + '개 생략</div>');
  }

  function render() {
    var st = i >= 0 ? simulate(i) : { dist: 0, saved: [], said: [], wrong: 0, idx: 0 };
    var set = function (id, v, cls) {
      var e = document.getElementById(id); e.textContent = v;
      e.parentElement.className = "cell" + (cls ? " " + cls : "");
    };
    set("v-dist", (st.dist / 1000).toFixed(2) + " km");
    set("v-saved", st.saved.length + "개");
    set("v-wrong", st.wrong + "번", st.wrong ? "alarm" : "");
    fill(document.getElementById("saved"), st.saved, "saved");
    fill(document.getElementById("said"), st.said, "say");

    var note = document.getElementById("note");
    if (i < 0) { note.className = "note"; note.textContent = "재생을 누르면 위치가 하나씩 들어온다."; return; }
    if (mode === "stream") {
      note.className = "note fine";
      note.innerHTML = "스플릿이 <b>실제로 완성되는 그 줄에서만</b> 신호를 한 번 흘려보낸다. 저장용 목록은 그대로 쌓이고, 안내는 1km마다 정확히 한 번씩만 나온다.";
    } else if (st.wrong === 0) {
      note.className = "note";
      note.innerHTML = "아직 자투리가 100m를 못 넘겨서 아무 일도 안 일어났다. 조금만 더 가보자.";
    } else {
      note.className = "note alarm";
      note.innerHTML = "확인하려고 부른 것뿐인데 <b>부를 때마다 자투리가 스플릿으로 확정</b>됐다. 번호까지 같이 써버려서, " +
        (st.dist / 1000).toFixed(2) + "km를 뛴 지금 안내는 이미 <b>" + st.idx + "킬로미터</b>라고 말하고 있다. 저장되는 기록도 같이 망가진다.";
    }
  }

  function stop(){ if(timer){clearInterval(timer);timer=null;} document.getElementById("play").textContent="재생"; }
  function step(){ if(i>=MOVES.length-1){stop();return;} i++; render(); }
  document.getElementById("step").addEventListener("click",function(){stop();step();});
  document.getElementById("reset").addEventListener("click",function(){stop();i=-1;render();});
  document.getElementById("play").addEventListener("click",function(){
    if(timer){stop();return;}
    if(i>=MOVES.length-1) i=-1;
    this.textContent="일시정지"; step(); timer=setInterval(step,750);
  });
  document.querySelectorAll("#seg button").forEach(function(b){
    b.addEventListener("click",function(){
      mode=b.dataset.mode;
      document.querySelectorAll("#seg button").forEach(function(x){x.setAttribute("aria-pressed",String(x===b));});
      render();
    });
  });
  render();
})();
</script>
</body>
</html>
</file>

<file path="assets/demo/split_boundary_simulator.html">
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Split Boundary Simulator</title>
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#ffffff; --panel:#f7f8fa; --line:#e3e6ea; --ink:#16181d; --dim:#6b7280;
    --faint:#9aa1ab; --bad:#d0392b; --bad-bg:#fbeae8; --ok:#0d9276; --ok-bg:#e2f4ef;
    --mark:#2563eb; --grid:#eceff2;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:#09090b; --panel:#141417; --line:#27272a; --ink:#f4f4f5; --dim:#a1a1aa;
      --faint:#71717a; --bad:#f87171; --bad-bg:#331416; --ok:#34d399; --ok-bg:#0d2b23;
      --mark:#60a5fa; --grid:#1c1c20;
    }
  }
  * { box-sizing:border-box; }
  body { margin:0; padding:16px; background:var(--bg); color:var(--ink);
    font-family:'Inter',-apple-system,'Apple SD Gothic Neo',sans-serif;
    user-select:none; -webkit-user-select:none; }
  h1 { font-size:15px; font-weight:700; margin:0 0 5px; }
  .lead { font-size:12.5px; line-height:1.6; color:var(--dim); margin:0 0 14px; max-width:64ch; }
  .lead code { font-family:'Fira Code',monospace; font-size:11.5px; background:var(--panel); padding:1px 5px; border-radius:4px; }

  .bar { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:14px; }
  .bar > span { font-family:'Fira Code',monospace; font-size:10px; letter-spacing:.04em;
    color:var(--faint); text-transform:uppercase; margin-right:2px; }
  .seg { display:flex; border:1px solid var(--line); border-radius:7px; overflow:hidden; }
  .seg button { border:none; background:var(--bg); color:var(--dim); cursor:pointer;
    font-family:'Fira Code',monospace; font-size:11.5px; font-weight:500; padding:9px 14px;
    border-right:1px solid var(--line); transition:background .13s,color .13s; }
  .seg button:last-child { border-right:none; }
  .seg button[aria-pressed="true"] { background:var(--ok); color:var(--bg); font-weight:600; }
  .seg button.danger[aria-pressed="true"] { background:var(--bad); }
  .btn { border:1px solid var(--line); background:var(--panel); color:var(--ink); cursor:pointer;
    font-family:'Fira Code',monospace; font-size:11.5px; padding:9px 14px; border-radius:7px; }
  .btn.primary { background:var(--ok); border-color:var(--ok); color:var(--bg); font-weight:600; }
  .sp { flex:1 1 6px; }

  .row { display:grid; grid-template-columns:repeat(4,1fr); gap:7px; margin-bottom:12px; }
  .cell { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:9px 11px; min-width:0; }
  .cell .k { font-family:'Fira Code',monospace; font-size:8.5px; letter-spacing:.04em; text-transform:uppercase; color:var(--faint); }
  .cell .v { font-family:'Fira Code',monospace; font-size:16px; font-weight:600; margin-top:4px; font-variant-numeric:tabular-nums; }
  .cell.alarm { background:var(--bad-bg); border-color:var(--bad); }
  .cell.alarm .v { color:var(--bad); }
  .cell.good .v { color:var(--ok); }
  @media (max-width:520px){ .row{grid-template-columns:repeat(2,1fr);} }

  .track { border:1px solid var(--line); border-radius:9px; background:var(--panel); padding:12px 10px 6px; overflow-x:auto; }
  .track svg { display:block; width:100%; min-width:460px; height:auto; }

  .note { margin-top:12px; font-size:12.5px; line-height:1.65; color:var(--dim); border-left:2px solid var(--line); padding-left:12px; }
  .note b { color:var(--ink); font-weight:600; }
  .note.alarm { border-left-color:var(--bad); }
  .note.fine { border-left-color:var(--ok); }
</style>
</head>
<body>

<h1>신호가 끊긴 사이 1km를 훌쩍 넘겼다면</h1>
<p class="lead">누적 거리가 1km 경계를 넘을 때마다 스플릿을 하나 만든다. 그런데 위치가 한 번에 크게 뛰면 <b>한 번의 업데이트 안에서 경계를 두 개 넘을 수도</b> 있다. 그때 <code>if</code>로 검사하면 하나만 만들고 끝난다.</p>

<div class="bar">
  <span>경계 검사</span>
  <div class="seg" id="seg">
    <button type="button" class="danger" data-mode="if" aria-pressed="true">if 로 한 번</button>
    <button type="button" data-mode="while" aria-pressed="false">while 로 반복</button>
  </div>
  <span class="sp"></span>
  <button type="button" class="btn" id="reset">처음으로</button>
  <button type="button" class="btn" id="step">위치 하나 더</button>
  <button type="button" class="btn primary" id="play">재생</button>
</div>

<div class="row">
  <div class="cell"><div class="k">이번 이동</div><div class="v" id="v-move">--</div></div>
  <div class="cell"><div class="k">누적 거리</div><div class="v" id="v-dist">--</div></div>
  <div class="cell"><div class="k">다음 경계</div><div class="v" id="v-next">--</div></div>
  <div class="cell"><div class="k">만든 스플릿</div><div class="v" id="v-made">--</div></div>
</div>

<div class="track"><div id="plot"></div></div>
<div class="note" id="note">재생을 누르면 위치가 하나씩 들어온다.</div>

<script>
(function () {
  "use strict";
  var UNIT = 1000;
  // 4번째에서 신호가 끊겼다 돌아오며 1.4km를 한 번에 이동한다
  var MOVES = [400, 500, 600, 400, 1400, 200, 300, 250, 300];
  var GAP_AT = 4;

  var mode = "if", i = -1, timer = null;

  function simulate(upto) {
    var dist = 0, nextAt = UNIT, made = 0, lost = 0, marks = [];
    for (var k = 0; k <= upto; k++) {
      dist += MOVES[k];
      if (mode === "while") {
        while (dist >= nextAt) { made++; marks.push({ at: nextAt, n: made }); nextAt += UNIT; }
      } else {
        if (dist >= nextAt) {
          made++; marks.push({ at: nextAt, n: made }); nextAt += UNIT;
          // if 는 한 번만 검사하므로 남은 경계는 그냥 지나쳐버린다
          while (dist >= nextAt) { lost++; nextAt += UNIT; }
        }
      }
    }
    return { dist: dist, nextAt: nextAt, made: made, lost: lost, marks: marks };
  }

  function draw(st, upto) {
    var W = 780, H = 108, PL = 14, PR = 14, Y = 52;
    var maxD = 4600;
    var X = function (d) { return PL + Math.min(d, maxD) / maxD * (W - PL - PR); };
    var s = '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="누적 거리와 스플릿 경계">';
    // 1km 경계선
    for (var b = UNIT; b <= maxD; b += UNIT) {
      s += '<line x1="' + X(b).toFixed(1) + '" y1="' + (Y - 22) + '" x2="' + X(b).toFixed(1) + '" y2="' + (Y + 16) + '" stroke="var(--grid)" stroke-width="2"/>';
      s += '<text x="' + X(b).toFixed(1) + '" y="' + (Y + 30) + '" text-anchor="middle" font-size="9" font-family="Fira Code,monospace" fill="var(--faint)">' + (b / 1000) + 'km</text>';
    }
    // 지나온 거리 막대
    s += '<rect x="' + PL + '" y="' + (Y - 7) + '" width="' + (X(st.dist) - PL).toFixed(1) + '" height="14" rx="7" fill="var(--mark)" opacity="0.22"/>';
    // 신호 끊긴 구간
    if (upto >= GAP_AT) {
      var before = MOVES.slice(0, GAP_AT).reduce(function (a, b2) { return a + b2; }, 0);
      s += '<rect x="' + X(before).toFixed(1) + '" y="' + (Y - 7) + '" width="' + (X(before + MOVES[GAP_AT]) - X(before)).toFixed(1) + '" height="14" rx="7" fill="var(--faint)" opacity="0.3"/>';
      s += '<text x="' + ((X(before) + X(before + MOVES[GAP_AT])) / 2).toFixed(1) + '" y="' + (Y - 14) + '" text-anchor="middle" font-size="9" font-family="Fira Code,monospace" fill="var(--faint)">신호 끊김</text>';
    }
    // 현재 위치
    s += '<circle cx="' + X(st.dist).toFixed(1) + '" cy="' + Y + '" r="6" fill="var(--mark)"/>';
    // 만들어진 스플릿
    st.marks.forEach(function (m) {
      s += '<circle cx="' + X(m.at).toFixed(1) + '" cy="' + (Y - 22) + '" r="8" fill="var(--ok)"/>';
      s += '<text x="' + X(m.at).toFixed(1) + '" y="' + (Y - 19) + '" text-anchor="middle" font-size="9" font-weight="700" font-family="Fira Code,monospace" fill="var(--bg)">' + m.n + '</text>';
    });
    // 놓친 경계
    if (st.lost > 0) {
      var missed = [], b3 = UNIT;
      while (b3 < st.nextAt) {
        if (!st.marks.some(function (m) { return m.at === b3; }) && b3 <= st.dist) missed.push(b3);
        b3 += UNIT;
      }
      missed.forEach(function (d) {
        s += '<circle cx="' + X(d).toFixed(1) + '" cy="' + (Y - 22) + '" r="8" fill="none" stroke="var(--bad)" stroke-width="1.6" stroke-dasharray="2.5 2"/>';
        s += '<text x="' + X(d).toFixed(1) + '" y="' + (Y - 19) + '" text-anchor="middle" font-size="10" font-weight="700" font-family="Fira Code,monospace" fill="var(--bad)">×</text>';
      });
    }
    s += '</svg>';
    document.getElementById("plot").innerHTML = s;
  }

  function render() {
    var st = i >= 0 ? simulate(i) : { dist: 0, nextAt: UNIT, made: 0, lost: 0, marks: [] };
    var set = function (id, v, cls) {
      var e = document.getElementById(id); e.textContent = v;
      e.parentElement.className = "cell" + (cls ? " " + cls : "");
    };
    set("v-move", i >= 0 ? MOVES[i] + " m" : "--", i === GAP_AT ? "alarm" : "");
    set("v-dist", (st.dist / 1000).toFixed(2) + " km");
    set("v-next", (st.nextAt / 1000).toFixed(0) + " km");
    set("v-made", st.made + "개" + (st.lost ? " (" + st.lost + "개 놓침)" : ""), st.lost ? "alarm" : (st.made ? "good" : ""));
    draw(st, i);

    var note = document.getElementById("note");
    if (i < 0) { note.className = "note"; note.textContent = "재생을 누르면 위치가 하나씩 들어온다."; return; }
    if (i === GAP_AT) {
      if (mode === "if") {
        note.className = "note alarm";
        note.innerHTML = "신호가 끊긴 사이 <b>1.4km를 한 번에 이동</b>했다. 경계를 두 개 넘었는데 <code>if</code>는 <b>한 번만 검사</b>하니 스플릿을 하나만 만들고 나머지는 그냥 지나쳤다.";
      } else {
        note.className = "note fine";
        note.innerHTML = "같은 상황인데 <code>while</code>이라 <b>넘긴 경계 수만큼 반복</b>한다. 이번 한 번의 업데이트 안에서 스플릿이 두 개 만들어졌다.";
      }
    } else if (st.lost > 0) {
      note.className = "note alarm";
      note.innerHTML = "놓친 경계는 되돌아오지 않는다. <b>다음 경계 기준이 " + st.lost + "km씩 밀린 채로</b> 남은 러닝 내내 이어진다.";
    } else if (st.made > 0) {
      note.className = "note fine";
      note.innerHTML = st.made + "번째 경계까지 정상적으로 기록됐다. 다음 경계는 " + (st.nextAt / 1000) + "km다.";
    } else {
      note.className = "note";
      note.innerHTML = "아직 1km 전이다. 심박과 케이던스 샘플만 쌓이고 있다.";
    }
  }

  function stop(){ if(timer){clearInterval(timer);timer=null;} document.getElementById("play").textContent="재생"; }
  function step(){ if(i>=MOVES.length-1){stop();return;} i++; render(); }
  document.getElementById("step").addEventListener("click",function(){stop();step();});
  document.getElementById("reset").addEventListener("click",function(){stop();i=-1;render();});
  document.getElementById("play").addEventListener("click",function(){
    if(timer){stop();return;}
    if(i>=MOVES.length-1) i=-1;
    this.textContent="일시정지"; step(); timer=setInterval(step,900);
  });
  document.querySelectorAll("#seg button").forEach(function(b){
    b.addEventListener("click",function(){
      mode=b.dataset.mode;
      document.querySelectorAll("#seg button").forEach(function(x){x.setAttribute("aria-pressed",String(x===b));});
      render();
    });
  });
  render();
})();
</script>
</body>
</html>
</file>

