            }
        }

        self.detailImageView.image = selectedImage
        
        picker.dismiss(animated: true)
        
    }
    
    
func getImage() {
    guard let urlString = imageUrl else { return }
        
    imageManager.downloadImage(urlString: urlString) { [weak self] image in
